+//
+// Frosted glass.
+//
+// A translucent panel painted into an icon cannot blur what is behind it: the
+// icon is generated long before anyone knows where rEFInd will draw it. But by
+// the time an entry is painted the background has already been cropped to the
+// exact tile, so the blur can be done here, at draw time, and is therefore
+// correct for any number of entries and any position.
+//
+// The mask is the icon itself. Its alpha says where the glass is, so the blur
+// is applied in proportion to it: opaque logo and empty margin are left sharp,
+// the translucent plate is frosted.
+//
+static VOID egBoxBlurPass(EG_PIXEL *Src, EG_PIXEL *Dst, UINTN W, UINTN Hgt, UINTN Radius) {
+    UINTN x, y, i, Span, Count;
+    UINTN Sb, Sg, Sr;
+    EG_PIXEL *Row;
+
+    Span = Radius * 2 + 1;
+    for (y = 0; y < Hgt; y++) {
+        Row = Src + y * W;
+        Sb = Sg = Sr = 0;
+        Count = 0;
+        for (i = 0; i <= Radius && i < W; i++) {
+            Sb += Row[i].b; Sg += Row[i].g; Sr += Row[i].r; Count++;
+        }
+        for (x = 0; x < W; x++) {
+            Dst[y * W + x].b = (UINT8)(Sb / Count);
+            Dst[y * W + x].g = (UINT8)(Sg / Count);
+            Dst[y * W + x].r = (UINT8)(Sr / Count);
+            Dst[y * W + x].a = Row[x].a;
+            if (x >= Radius) {
+                Sb -= Row[x - Radius].b; Sg -= Row[x - Radius].g; Sr -= Row[x - Radius].r;
+                Count--;
+            }
+            if (x + Radius + 1 < W) {
+                Sb += Row[x + Radius + 1].b; Sg += Row[x + Radius + 1].g;
+                Sr += Row[x + Radius + 1].r; Count++;
+            }
+        }
+    }
+    (VOID) Span;
+}
+
+static VOID egTranspose(EG_PIXEL *Src, EG_PIXEL *Dst, UINTN W, UINTN Hgt) {
+    UINTN x, y;
+    for (y = 0; y < Hgt; y++)
+        for (x = 0; x < W; x++)
+            Dst[x * Hgt + y] = Src[y * W + x];
+}
+
+// Blur Image wherever Mask is opaque, leaving it sharp where Mask is clear.
+//
+// Mask is a stencil of a sheet of glass, not a picture of one: its alpha says
+// WHERE the glass is, not how transparent it is. That distinction is the whole
+// point. Blending in proportion to a translucent panel's own alpha yields a
+// background that is a quarter blurred and three quarters sharp, which reads as
+// a slightly soft photograph rather than as glass. Real frosted glass scatters
+// everything that passes through it: behind the pane the view is *fully*
+// blurred, and the pane's own tint is then laid over that. So the pane's
+// translucency belongs to the compositing step that follows, and the only thing
+// asked of the mask here is the shape of the pane.
+//
+// The stencil is centred the way BltImageCompositeBadge() centres an icon, so a
+// mask built against the icon's geometry lands exactly on the icon's panel.
+VOID egFrostImage(IN OUT EG_IMAGE *Image, IN EG_IMAGE *Mask, IN UINTN Radius) {
+    UINTN     W, Hgt, x, y, i, Total, Alpha, RevAlpha, Temp;
+    INTN      MaskX, MaskY, mx, my;
+    EG_PIXEL  *A, *B, *Blurred;
+
+    if (!Image || !Mask || Radius == 0 || !Mask->HasAlpha)
+        return;
+    W = Image->Width; Hgt = Image->Height;
+    Total = W * Hgt;
+    if (Total == 0 || Radius >= W || Radius >= Hgt)
+        return;
+
+    A = (EG_PIXEL *) AllocatePool(Total * sizeof(EG_PIXEL));
+    B = (EG_PIXEL *) AllocatePool(Total * sizeof(EG_PIXEL));
+    if (!A || !B) { MyFreePool(&A); MyFreePool(&B); return; }
+
+    // two box passes per axis approximate a Gaussian closely enough
+    egBoxBlurPass(Image->PixelData, A, W, Hgt, Radius);
+    egBoxBlurPass(A, B, W, Hgt, Radius);
+    egTranspose(B, A, W, Hgt);
+    egBoxBlurPass(A, B, Hgt, W, Radius);
+    egBoxBlurPass(B, A, Hgt, W, Radius);
+    egTranspose(A, B, Hgt, W);
+    Blurred = B;
+
+    // the icon is centred in the tile, exactly as BltImageCompositeBadge does
+    MaskX = ((INTN) W  - (INTN) Mask->Width)  / 2;
+    MaskY = ((INTN) Hgt - (INTN) Mask->Height) / 2;
+
+    for (y = 0; y < Hgt; y++) {
+        my = (INTN) y - MaskY;
+        if (my < 0 || my >= (INTN) Mask->Height)
+            continue;
+        for (x = 0; x < W; x++) {
+            mx = (INTN) x - MaskX;
+            if (mx < 0 || mx >= (INTN) Mask->Width)
+                continue;
+            Alpha = Mask->PixelData[my * Mask->Width + mx].a;
+            if (Alpha == 0)
+                continue;
+            i = y * W + x;
+            RevAlpha = 255 - Alpha;
+            Temp = (UINTN) Image->PixelData[i].b * RevAlpha + (UINTN) Blurred[i].b * Alpha + 0x80;
+            Image->PixelData[i].b = (UINT8) ((Temp + (Temp >> 8)) >> 8);
+            Temp = (UINTN) Image->PixelData[i].g * RevAlpha + (UINTN) Blurred[i].g * Alpha + 0x80;
+            Image->PixelData[i].g = (UINT8) ((Temp + (Temp >> 8)) >> 8);
+            Temp = (UINTN) Image->PixelData[i].r * RevAlpha + (UINTN) Blurred[i].r * Alpha + 0x80;
+            Image->PixelData[i].r = (UINT8) ((Temp + (Temp >> 8)) >> 8);
+        }
+    }
+    MyFreePool(&A);
+    MyFreePool(&B);
+} // VOID egFrostImage()
