+// Frosting a tile is the expensive part of drawing one -- four box passes and
+// two transposes over 380,000 pixels -- and it depends only on where the tile
+// is, never on which frame it is or whether it is selected. Every arrow key was
+// paying for two of them. They are kept instead, and thrown away when the
+// background changes.
+#define FROST_CACHE (12)
+static struct { UINTN X, Y, W, H, Row; EG_IMAGE *Img; } FrostKept[FROST_CACHE];
+static UINTN FrostKeptNext = 0;
+
+static VOID ForgetFrost(VOID) {
+    UINTN i;
+
+    for (i = 0; i < FROST_CACHE; i++) {
+        egFreeImage(FrostKept[i].Img);
+        FrostKept[i].Img = NULL;
+    }
+    FrostKeptNext = 0;
+} // VOID ForgetFrost()
+
+// The photograph at this position, frosted where the glass is. A copy, because
+// the caller composites an icon into it.
+static EG_IMAGE * FrostedCrop(IN UINTN XPos, IN UINTN YPos, IN UINTN W, IN UINTN H,
+                              IN UINTN Row) {
+    EG_IMAGE *Fresh;
+    UINTN     i;
+
+    for (i = 0; i < FROST_CACHE; i++) {
+        if ((FrostKept[i].Img != NULL) && (FrostKept[i].X == XPos) &&
+            (FrostKept[i].Y == YPos) && (FrostKept[i].W == W) &&
+            (FrostKept[i].H == H) && (FrostKept[i].Row == Row))
+            return egCopyImage(FrostKept[i].Img);
+    }
+    Fresh = egCropImage(GlobalConfig.ScreenBackground, XPos, YPos, W, H);
+    if (Fresh == NULL)
+        return NULL;
+    egFrostImage(Fresh, FrostImages[Row], GlobalConfig.FrostRadius);
+    egFreeImage(FrostKept[FrostKeptNext].Img);
+    FrostKept[FrostKeptNext].X = XPos; FrostKept[FrostKeptNext].Y = YPos;
+    FrostKept[FrostKeptNext].W = W;    FrostKept[FrostKeptNext].H = H;
+    FrostKept[FrostKeptNext].Row = Row;
+    FrostKept[FrostKeptNext].Img = egCopyImage(Fresh);
+    FrostKeptNext = (FrostKeptNext + 1) % FROST_CACHE;
+    return Fresh;
+} // EG_IMAGE * FrostedCrop()
+
+// A finished tile, not yet on the screen: the photograph behind it, frosted
+// where the glass is, the highlight if it is the selected one, then the icon.
+// Everything that draws a tile goes through this, so a tile in an animation and
+// a tile sitting still are the same pixels.
+static EG_IMAGE * ComposeTile(IN EG_IMAGE *Icon, IN EG_IMAGE *Badge, IN UINTN Row,
+                              IN BOOLEAN Selected, IN UINTN XPos, IN UINTN YPos) {
+    EG_IMAGE *Tile;
+    UINTN     W, H, CW = 0, CH = 0, OffX = 0, OffY = 0;
+
+    if (SelectionImages[Row] == NULL)
+        return NULL;
+    W = SelectionImages[Row]->Width;
+    H = SelectionImages[Row]->Height;
+    Tile = FrostedCrop(XPos, YPos, W, H, Row);
+    if (Tile == NULL)
+        return NULL;
+    if (Selected && DrawSelection)
+        egComposeImage(Tile, SelectionImages[Row], 0, 0);
+    if (Icon != NULL) {
+        CW = (Icon->Width  > W) ? W : Icon->Width;
+        CH = (Icon->Height > H) ? H : Icon->Height;
+        OffX = (W - CW) >> 1;
+        OffY = (H - CH) >> 1;
+        egComposeImage(Tile, Icon, OffX, OffY);
+    }
+    if ((Badge != NULL) && ((Badge->Width + 8) < CW) && ((Badge->Height + 8) < CH))
+        egComposeImage(Tile, Badge, OffX + CW - 8 - Badge->Width,
+                                    OffY + CH - 8 - Badge->Height);
+    return Tile;
+}
