+/*
+ * refind/theme.h
+ * Choosing and applying the look, from inside the boot menu.
+ */
+
+#ifndef __THEME_H_
+#define __THEME_H_
+
+#include "global.h"
+#include "menu.h"       // SCROLL_STATE, MENU_FUNCTION_*
+#include "../libeg/libeg.h"
+
+// Work out the colours from the current background and lay them over the icons,
+// the tool glyphs, the selection and the spinner. Safe to call repeatedly: the
+// artwork is kept as it was loaded and tinted from that copy every time.
+VOID ApplyTheme(VOID);
+
+// Forget the icons remembered from a menu that no longer exists.
+VOID ThemeForgetIcons(VOID);
+
+// The background coming up out of black, and going back down into it.
+VOID ThemeFadeIn(VOID);
+VOID ThemeFadeOut(VOID);
+
+// The settings screen: background, dimming, glass, colour, animation, and a way
+// to write the choices to EFI\refind\theme.conf so they survive a reboot.
+VOID ShowSettingsMenu(VOID);
+
+// Every sub-menu drawn as a pane of the same glass the tiles are made of.
+VOID ThemeMenuStyle(IN REFIT_MENU_SCREEN *Screen, IN SCROLL_STATE *State,
+                    IN UINTN Function, IN CHAR16 *ParamText);
+
+// Tint one image the way the rest of the theme is tinted.
+EG_IMAGE * ThemeTint(IN EG_IMAGE *Source);
+
+#endif
