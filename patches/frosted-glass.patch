+//
+// The handoff splash
+//
+// Plymouth cannot do this. It lives inside Ubuntu's initramfs and only runs
+// when Ubuntu is what you picked -- so it can never be the boot logo of
+// Windows, or of a stick plugged in this morning. rEFInd is the one thing that
+// runs before every one of them, and it already holds, for each entry it found,
+// the icon carrying that system's logo and name. So the splash belongs here,
+// and it is right for anything the machine ever boots without being told what.
+//
+// No floating point: rEFInd is an EFI application and does not set up the FPU,
+// so the whole animation is fixed point. Angles are in 4096ths of a turn and
+// sines are 4096ths of one, read from a quarter-wave table with linear
+// interpolation -- under a pixel of error on a radius of 110.
+
+#define SPIN_DOTS    (6)
+#define SPIN_PERIOD  (1800)   // milliseconds for one turn
+#define SPIN_STAGGER (410)    // 0.100 of a period between one dot and the next
+#define SPIN_SWING   (359)    // 0.55 rad of easing, as 4096ths of a turn
+#define SPIN_FRAME   (20)     // milliseconds a frame is held: 50 a second
+
+static const INTN SinTable[65] = {
+        0,   101,   201,   301,   401,   501,   601,   700,
+      799,   897,   995,  1092,  1189,  1285,  1380,  1474,
+     1567,  1660,  1751,  1842,  1931,  2019,  2106,  2191,
+     2276,  2359,  2440,  2520,  2598,  2675,  2751,  2824,
+     2896,  2967,  3035,  3102,  3166,  3229,  3290,  3349,
+     3406,  3461,  3513,  3564,  3612,  3659,  3703,  3745,
+     3784,  3822,  3857,  3889,  3920,  3948,  3973,  3996,
+     4017,  4036,  4052,  4065,  4076,  4085,  4091,  4095,
+     4096
+};
+
+// sin(2*pi*A/4096), in 4096ths.
+static INTN SinQ(INTN A) {
+    INTN Sign = 1, Index, Frac;
+
+    A &= 4095;
+    if (A >= 2048) { A -= 2048; Sign = -1; }
+    if (A > 1024) A = 2048 - A;
+    Index = A >> 4;
+    if (Index >= 64)                              // A == 1024 exactly: sin is 1,
+        return Sign * SinTable[64];               // and there is no next entry
+    Frac = A & 15;
+    return Sign * (SinTable[Index] + ((SinTable[Index + 1] - SinTable[Index]) * Frac) / 16);
+}
+
+static INTN CosQ(INTN A) {
+    return SinQ(A + 1024);
+}
+
+// A white disc with a soft edge, drawn by counting how much of each pixel the
+// circle covers. Sixteen samples is plenty at this size and needs no filtering.
+// Only used when the theme supplies no dot of its own: a theme that takes its
+// colours from a photograph wants a dot of that colour, not a white one.
+static EG_IMAGE * MakeDot(UINTN Size) {
+    EG_IMAGE *Image;
+    UINTN     x, y, sx, sy, Hits, i;
+    INTN      dx, dy, R2;
+
+    if (Size < 3)
+        return NULL;
+    Image = egCreateImage(Size, Size, TRUE);
+    if (Image == NULL)
+        return NULL;
+    R2 = 16 * (INTN) Size * (INTN) Size;          // radius Size/2, in eighths of a pixel
+    for (y = 0; y < Size; y++) {
+        for (x = 0; x < Size; x++) {
+            Hits = 0;
+            for (sy = 0; sy < 4; sy++) {
+                for (sx = 0; sx < 4; sx++) {
+                    dx = (INTN) (8 * x + 2 * sx + 1) - 4 * (INTN) Size;
+                    dy = (INTN) (8 * y + 2 * sy + 1) - 4 * (INTN) Size;
+                    if (dx * dx + dy * dy <= R2)
+                        Hits++;
+                }
+            }
+            i = y * Size + x;
+            Image->PixelData[i].r = 255;
+            Image->PixelData[i].g = 255;
+            Image->PixelData[i].b = 255;
+            Image->PixelData[i].a = (UINT8) ((Hits * 255) / 16);
+        }
+    }
+    return Image;
+}
+
+// The first row of an image with anything drawn on it. The icon is a panel with
+// a name under it inside a larger transparent square, so the square's own edge
+// says nothing about where the ink starts.
+static INTN ImageInkTop(IN EG_IMAGE *Image) {
+    UINTN x, y;
+
+    if (Image == NULL)
+        return 0;
+    for (y = 0; y < Image->Height; y++)
+        for (x = 0; x < Image->Width; x++)
+            if (Image->PixelData[y * Image->Width + x].a > 8)
+                return (INTN) y;
+    return 0;
+}
+
+// The menu leaving. Everything except the tile you chose dissolves back into the
+// photograph, and then that tile travels to the middle, where the ring is about
+// to start turning. It is the same tile the whole way: the frost is recomputed
+// at each position, because glass shows what is behind it and what is behind it
+// changes as it moves.
+//
+// Each frame is one blit of a box holding both the old position and the new, so
+// the tile is never briefly absent from the screen.
+static VOID AnimateHandoff(IN EG_IMAGE *Icon, IN UINTN DestX, IN UINTN DestY) {
+    EG_IMAGE *Strip, *StripBg, *Held, *Tile, *Box, *Rest;
+    UINTN     Size, StripY, StripH, f, Alpha, BoxX, BoxY, BoxW, BoxH;
+    INTN      FromX, FromY, X, Y, PrevX, PrevY;
+
+    Size   = TileSizes[0];
+    StripY = ComputeRow0PosY();
+    StripH = Size + TILE_YSPACING + TileSizes[1] + TILE_YSPACING + 4 * egGetFontHeight();
+    if (StripY + StripH > UGAHeight)
+        StripH = UGAHeight - StripY;
+
+    // 1. the rest of the menu dissolves, the chosen tile held in place over it
+    Strip   = egCopyScreenArea(0, StripY, UGAWidth, StripH);
+    StripBg = egCropImage(GlobalConfig.ScreenBackground, 0, StripY, UGAWidth, StripH);
+    Held    = egCopyScreenArea(ChosenX, ChosenY, Size, Size);
+    if ((Strip != NULL) && (StripBg != NULL) && (Held != NULL)) {
+        for (f = 1; f <= ANIM_OUT_FRAMES; f++) {
+            Alpha = EaseOut(f, ANIM_OUT_FRAMES);
+            BlendBlit(Strip, StripBg, Alpha, 0, StripY);
+            BltImage(Held, ChosenX, ChosenY);
+            refit_call1_wrapper(BS->Stall, ANIM_FRAME_US);
+        }
+    }
+    egFreeImage(Strip);
+    egFreeImage(StripBg);
+    egFreeImage(Held);
+
+    // whatever the strip did not reach -- hints along the bottom, if they are shown
+    if (StripY + StripH < UGAHeight) {
+        Rest = egCropImage(GlobalConfig.ScreenBackground, 0, StripY + StripH,
+                           UGAWidth, UGAHeight - StripY - StripH);
+        if (Rest != NULL) {
+            BltImage(Rest, 0, StripY + StripH);
+            egFreeImage(Rest);
+        }
+    }
+
+    // 2. the tile travels
+    FromX = (INTN) ChosenX; FromY = (INTN) ChosenY;
+    PrevX = FromX;          PrevY = FromY;
+    for (f = 1; f <= ANIM_MOVE_FRAMES; f++) {
+        Alpha = EaseOut(f, ANIM_MOVE_FRAMES);
+        X = FromX + (((INTN) DestX - FromX) * (INTN) Alpha) / 256;
+        Y = FromY + (((INTN) DestY - FromY) * (INTN) Alpha) / 256;
+
+        BoxX = (UINTN) ((X < PrevX) ? X : PrevX);
+        BoxY = (UINTN) ((Y < PrevY) ? Y : PrevY);
+        BoxW = (UINTN) (((X > PrevX) ? X : PrevX) + (INTN) Size) - BoxX;
+        BoxH = (UINTN) (((Y > PrevY) ? Y : PrevY) + (INTN) Size) - BoxY;
+
+        Box  = egCropImage(GlobalConfig.ScreenBackground, BoxX, BoxY, BoxW, BoxH);
+        Tile = ComposeTile(Icon, NULL, 0, TRUE, (UINTN) X, (UINTN) Y);
+        if ((Box != NULL) && (Tile != NULL)) {
+            egComposeImage(Box, Tile, (UINTN) X - BoxX, (UINTN) Y - BoxY);
+            BltImage(Box, BoxX, BoxY);
+        }
+        egFreeImage(Box);
+        egFreeImage(Tile);
+        PrevX = X; PrevY = Y;
+        refit_call1_wrapper(BS->Stall, ANIM_FRAME_US);
+    }
+} // VOID AnimateHandoff()
+
+// Show the chosen system on its own, the way the menu showed it, with a ring of
+// dots turning underneath, and then get out of the way. Icon is the entry's own
+// image, so this is correct for a system nobody has installed yet.
+VOID ShowHandoffSplash(IN EG_IMAGE *Icon) {
+    EG_IMAGE *Tile, *Dot, *Band, *Loaded;
+    UINTN     Elapsed = 0, Ring, DotSize, Span, TileX, BandX, BandY, d;
+    INTN      Theta, Angle, TileY, CentreY, GroupTop, GroupBottom, Shift;
+
+    if ((GlobalConfig.HandoffSplash == 0) || !AllowGraphicsMode ||
+        (Icon == NULL) || (GlobalConfig.ScreenBackground == NULL))
+        return;
+
+    SwitchToGraphics();
+    TileSizes[0] = (GlobalConfig.IconSizes[ICON_SIZE_BIG] * 9) / 8;
+    TileSizes[1] = (GlobalConfig.IconSizes[ICON_SIZE_SMALL] * 4) / 3;
+    InitSelection();
+
+    // Work out where everything goes before drawing any of it, because centring
+    // the tile is not the same as centring the picture. The panel sits high
+    // inside the icon with the name beneath it, and the ring hangs below that
+    // again, so a tile in the middle of the screen leaves the group people
+    // actually look at sitting low -- by 195 px at 3840x2160. Measure the ink
+    // instead of the boxes and shift the whole group until it is centred; taking
+    // the top from the icon's own alpha keeps that true for an icon with a
+    // longer name, or with none.
+    TileX   = (UGAWidth + TILE_XSPACING - (TileSizes[0] + TILE_XSPACING)) / 2;
+    Ring    = (110 * UGAHeight) / 2160;
+    DotSize = (20 * UGAHeight) / 2160;
+    if (DotSize < 4)
+        DotSize = 4;
+
+    TileY   = (INTN) ComputeRow0PosY();
+    CentreY = TileY + (INTN) TileSizes[0] + TILE_YSPACING + (INTN) TileSizes[1]
+              + TILE_YSPACING + (75 * (INTN) UGAHeight) / 2160;
+    GroupTop    = TileY + ((INTN) TileSizes[0] - (INTN) Icon->Height) / 2 + ImageInkTop(Icon);
+    GroupBottom = CentreY + (INTN) Ring + (INTN) DotSize / 2;
+    Shift       = (INTN) UGAHeight / 2 - (GroupTop + GroupBottom) / 2;
+    TileY      += Shift;
+    CentreY    += Shift;
+    if (TileY < 0)
+        TileY = 0;
+    if (CentreY < (INTN) (Ring + DotSize))
+        CentreY = (INTN) (Ring + DotSize);
+
+    if (GlobalConfig.Animations && ChosenKnown &&
+        ((ChosenX != TileX) || (ChosenY != (UINTN) TileY))) {
+        // travel there from where the menu had it
+        AnimateHandoff(Icon, TileX, (UINTN) TileY);
+    } else {
+        // the photograph, with the menu wiped off it, and the entry on top
+        BltImage(GlobalConfig.ScreenBackground, 0, 0);
+        Tile = ComposeTile(Icon, NULL, 0, TRUE, TileX, (UINTN) TileY);
+        if (Tile != NULL) {
+            BltImage(Tile, TileX, (UINTN) TileY);
+            egFreeImage(Tile);
+        }
+    }
+
+    // the ring
+    Span  = 2 * (Ring + DotSize);
+    BandX = (UGAWidth / 2) - Ring - DotSize;
+    BandY = (UINTN) CentreY - Ring - DotSize;
+    Dot = NULL;
+    if (GlobalConfig.HandoffDotFileName != NULL) {
+        Loaded = egLoadImage(SelfDir, GlobalConfig.HandoffDotFileName, TRUE);
+        if (Loaded != NULL) {
+            Dot = egScaleImage(Loaded, DotSize, DotSize);
+            egFreeImage(Loaded);
+        }
+    }
+    if (Dot == NULL)
+        Dot = MakeDot(DotSize);
+
+    if ((Dot != NULL) && (BandY + Span <= UGAHeight)) {
+        while (Elapsed < GlobalConfig.HandoffSplash) {
+            // repaint the whole band from the untouched photograph, so the dots
+            // leave nothing behind them
+            Band = egCropImage(GlobalConfig.ScreenBackground, BandX, BandY, Span, Span);
+            if (Band == NULL)
+                break;
+            for (d = 0; d < SPIN_DOTS; d++) {
+                Theta = (INTN) ((Elapsed * 4096) / SPIN_PERIOD) - (INTN) (d * SPIN_STAGGER);
+                Theta &= 4095;
+                // a = theta - swing * sin(theta), then a quarter turn back so
+                // the dots start at the top
+                Angle = (Theta - (SPIN_SWING * SinQ(Theta)) / 4096 - 1024) & 4095;
+                egComposeImage(Band, Dot,
+                    (UINTN) ((INTN) (Ring + DotSize) + ((INTN) Ring * CosQ(Angle)) / 4096
+                             - (INTN) DotSize / 2),
+                    (UINTN) ((INTN) (Ring + DotSize) + ((INTN) Ring * SinQ(Angle)) / 4096
+                             - (INTN) DotSize / 2));
+            }
+            BltImage(Band, BandX, BandY);
+            egFreeImage(Band);
+            refit_call1_wrapper(BS->Stall, SPIN_FRAME * 1000);
+            Elapsed += SPIN_FRAME;
+        }
+    }
+    egFreeImage(Dot);
+} // VOID ShowHandoffSplash()
