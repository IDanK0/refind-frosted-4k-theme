diff -urN a/refind/bgrt.c b/refind/bgrt.c
--- a/refind/bgrt.c	1970-01-01 01:00:00.000000000 +0100
+++ b/refind/bgrt.c	2026-09-01 21:38:36.500354345 +0200
@@ -0,0 +1,328 @@
+/*
+ * refind/bgrt.c
+ * Hand the picture on the screen to the next operating system.
+ *
+ * Copyright (c) 2026 Dan. Released under the terms of the GPLv3, like the rest
+ * of rEFInd.
+ *
+ * Every other system this menu boots can be given a splash by installing
+ * something inside it. Windows cannot: there is no initramfs to put a theme in
+ * and no theme to put there. But Windows does not choose the picture it shows
+ * while it starts either -- it reads one out of an ACPI table called BGRT, the
+ * Boot Graphics Resource Table, which the firmware fills in with the maker's
+ * logo. That is why a laptop shows its own badge during a Windows boot and not
+ * a Windows one.
+ *
+ * A bootloader is the last thing to run before the operating system, so it is
+ * the last thing that can write to that table. Put the screen there and Windows
+ * shows the screen. It needs nothing installed, survives Windows being
+ * reinstalled, and works for anything else that reads the table -- Linux does
+ * too, which is what makes it testable without booting Windows at all.
+ *
+ * Windows keeps drawing its own ring of dots underneath, and there is no way to
+ * ask it not to. So what is handed over is the picture without ours: the
+ * photograph and the tile, and Windows turns its own dots below them.
+ */
+
+#include "global.h"
+#include "lib.h"
+#include "screen.h"
+#include "bgrt.h"
+#include "../include/refit_call_wrapper.h"
+#include "log.h"
+
+// The two ways a firmware advertises where its ACPI tables are. Both have been
+// seen; take whichever is there, preferring the newer.
+static EFI_GUID Acpi20TableGuid = { 0x8868e871, 0xe4f1, 0x11d3,
+                                    { 0xbc, 0x22, 0x00, 0x80, 0xc7, 0x3c, 0x88, 0x81 }};
+static EFI_GUID Acpi10TableGuid = { 0xeb9d2d30, 0x2d88, 0x11d3,
+                                    { 0x9a, 0x16, 0x00, 0x90, 0x27, 0x3f, 0xc1, 0x4d }};
+
+#define ACPI_HEADER_LENGTH  (36)
+
+// BGRT, as ACPI 5.0 defines it: a 36-byte table header and twenty bytes saying
+// where the picture is and where it goes.
+#define BGRT_VERSION        (36)
+#define BGRT_STATUS         (38)
+#define BGRT_IMAGE_TYPE     (39)
+#define BGRT_IMAGE_ADDRESS  (40)
+#define BGRT_OFFSET_X       (48)
+#define BGRT_OFFSET_Y       (52)
+#define BGRT_LENGTH         (56)
+
+#define BMP_HEADER_LENGTH   (54)
+
+static UINT8 * AcpiTablePointer(VOID) {
+    UINTN i;
+
+    for (i = 0; i < ST->NumberOfTableEntries; i++) {
+        if (GuidsAreEqual(&(ST->ConfigurationTable[i].VendorGuid), &Acpi20TableGuid))
+            return (UINT8 *) ST->ConfigurationTable[i].VendorTable;
+    }
+    for (i = 0; i < ST->NumberOfTableEntries; i++) {
+        if (GuidsAreEqual(&(ST->ConfigurationTable[i].VendorGuid), &Acpi10TableGuid))
+            return (UINT8 *) ST->ConfigurationTable[i].VendorTable;
+    }
+    return NULL;
+} // UINT8 * AcpiTablePointer()
+
+// Does this table start with these four (or eight) characters?
+static BOOLEAN Signature(IN UINT8 *At, IN const char *Want) {
+    UINTN i;
+
+    if (At == NULL)
+        return FALSE;
+    for (i = 0; Want[i] != '\0'; i++)
+        if (At[i] != (UINT8) Want[i])
+            return FALSE;
+    return TRUE;
+} // BOOLEAN Signature()
+
+// ACPI structures are checksummed by summing every byte to zero.
+static BOOLEAN SumsToZero(IN UINT8 *At, IN UINTN Length) {
+    UINTN i;
+    UINT8 Sum = 0;
+
+    if ((At == NULL) || (Length == 0) || (Length > 0x10000))
+        return FALSE;
+    for (i = 0; i < Length; i++)
+        Sum = (UINT8) (Sum + At[i]);
+    return (Sum == 0);
+} // BOOLEAN SumsToZero()
+
+static UINT32 ReadU32(IN UINT8 *At) {
+    return (UINT32) At[0] | ((UINT32) At[1] << 8) |
+           ((UINT32) At[2] << 16) | ((UINT32) At[3] << 24);
+}
+
+static VOID WriteU32(OUT UINT8 *At, IN UINT32 Value) {
+    At[0] = (UINT8) (Value & 0xff);
+    At[1] = (UINT8) ((Value >> 8) & 0xff);
+    At[2] = (UINT8) ((Value >> 16) & 0xff);
+    At[3] = (UINT8) ((Value >> 24) & 0xff);
+}
+
+static VOID WriteU64(OUT UINT8 *At, IN UINT64 Value) {
+    WriteU32(At, (UINT32) (Value & 0xffffffffULL));
+    WriteU32(At + 4, (UINT32) ((Value >> 32) & 0xffffffffULL));
+}
+
+// An ACPI table is valid when its bytes sum to zero. Having changed some of
+// them, make that true again.
+static VOID Reseal(IN OUT UINT8 *Table) {
+    UINT32 Length = ReadU32(Table + 4);
+    UINT32 i;
+    UINT8  Sum = 0;
+
+    if ((Length < ACPI_HEADER_LENGTH) || (Length > 0x10000))
+        return;
+    Table[9] = 0;
+    for (i = 0; i < Length; i++)
+        Sum = (UINT8) (Sum + Table[i]);
+    Table[9] = (UINT8) (0 - Sum);
+} // VOID Reseal()
+
+// Find BGRT among the tables the root pointer lists.
+static UINT8 * FindBgrt(VOID) {
+    UINT8  *Rsdp, *Table;
+    UINT64  Address;
+    UINT32  Entries, i, Length;
+    UINT8  *List;
+    UINTN   Width;
+
+    Rsdp = AcpiTablePointer();
+    if (Rsdp == NULL)
+        return NULL;
+
+    // Check it really is the root pointer before believing anything in it.
+    //
+    // Everything that follows is an address read out of firmware-supplied memory
+    // and then dereferenced. On a machine whose configuration table points at
+    // something that is not an RSDP -- a table left behind by an earlier
+    // bootloader, a firmware bug, a deliberately malformed one -- following it
+    // reads whatever those eight bytes happened to be, as a pointer. The cost of
+    // being sure is thirty bytes of arithmetic, once, and the cost of not being
+    // sure is a machine that hangs before it boots.
+    if (!Signature(Rsdp, "RSD PTR "))
+        return NULL;
+    if (!SumsToZero(Rsdp, 20))               // ACPI 1.0 checksum: the first 20 bytes
+        return NULL;
+    if ((Rsdp[15] >= 2) && !SumsToZero(Rsdp, ReadU32(Rsdp + 20)))
+        return NULL;                          // ACPI 2.0 adds one over the whole thing
+
+    // Revision 2 and up carry a 64-bit XSDT; before that only a 32-bit RSDT.
+    if ((Rsdp[15] >= 2) && (ReadU32(Rsdp + 24) || ReadU32(Rsdp + 28))) {
+        Address = (UINT64) ReadU32(Rsdp + 24) | ((UINT64) ReadU32(Rsdp + 28) << 32);
+        Width   = 8;
+    } else {
+        Address = (UINT64) ReadU32(Rsdp + 16);
+        Width   = 4;
+    }
+    if (Address == 0)
+        return NULL;
+
+    Table  = (UINT8 *) (UINTN) Address;
+    if (!Signature(Table, (Width == 8) ? "XSDT" : "RSDT"))
+        return NULL;
+    Length = ReadU32(Table + 4);
+    if ((Length <= ACPI_HEADER_LENGTH) || (Length > 0x10000))
+        return NULL;
+    // The signature and the length, but deliberately not the checksum. The RSDP
+    // above is checksummed because a wrong one there means the pointer itself is
+    // not to be trusted; here the pointer has already been vouched for, and
+    // firmware that ships an XSDT whose bytes do not sum to zero is common
+    // enough that refusing on it would take the boot logo away from working
+    // machines to no purpose. The bounds below are what keep the walk safe.
+    Entries = (Length - ACPI_HEADER_LENGTH) / (UINT32) Width;
+    List    = Table + ACPI_HEADER_LENGTH;
+
+    for (i = 0; i < Entries; i++) {
+        UINT8 *Entry;
+        if (Width == 8)
+            Entry = (UINT8 *) (UINTN) ((UINT64) ReadU32(List + i * 8) |
+                                       ((UINT64) ReadU32(List + i * 8 + 4) << 32));
+        else
+            Entry = (UINT8 *) (UINTN) ReadU32(List + i * 4);
+        if (Entry == NULL)
+            continue;
+        if (Signature(Entry, "BGRT")) {
+            // A BGRT is exactly what ACPI 5.0 says it is. One that is not is
+            // one somebody else is using for something else.
+            if (ReadU32(Entry + 4) < BGRT_LENGTH)
+                continue;
+            return Entry;
+        }
+    }
+    return NULL;
+} // UINT8 * FindBgrt()
+
+// A 24-bit bottom-up BMP, which is the only thing BGRT is allowed to hold, in
+// boot-services memory, which is where a firmware puts its own.
+//
+// Not in the memory that is never reclaimed, which was the careful-looking
+// choice and the wrong one: Linux refuses a BGRT whose image is anywhere but
+// EFI_BOOT_SERVICES_DATA -- "Ignoring BGRT: invalid image address" -- because
+// that is what firmware does, and a table pointing anywhere else is more likely
+// to be wrong than to be clever. Nothing is lost by obeying: the pages stay
+// allocated because they are never freed, Windows reads them while boot
+// services are still alive, and Linux reserves them for itself the moment it
+// accepts the table.
+// The last one handed over, so a second attempt does not abandon the first.
+// A launch that fails -- a loader that has been moved, a kernel that is not
+// there -- comes back to the menu, and the next attempt used to allocate
+// another twenty-five megabytes and forget the address of the one before it.
+static EFI_PHYSICAL_ADDRESS LastBmp = 0;
+static UINTN                LastPages = 0;
+
+static UINT8 * MakeBmp(IN EG_IMAGE *Image, OUT UINTN *Size) {
+    UINTN   Row, Stride, Bytes, Pages, x, y;
+    UINT8  *Bmp, *Out;
+    EFI_PHYSICAL_ADDRESS Where = 0;
+    EFI_STATUS Status;
+
+    if ((Image == NULL) || (Image->Width == 0) || (Image->Height == 0))
+        return NULL;
+    // rows are padded to a multiple of four bytes
+    Row    = Image->Width * 3;
+    Stride = (Row + 3) & ~((UINTN) 3);
+    Bytes  = BMP_HEADER_LENGTH + Stride * Image->Height;
+    Pages  = (Bytes + 4095) / 4096;
+
+    Status = refit_call4_wrapper(BS->AllocatePages, AllocateAnyPages,
+                                 EfiBootServicesData, Pages, &Where);
+    if (EFI_ERROR(Status) || (Where == 0)) {
+        LOG(1, LOG_LINE_NORMAL, L"No memory for the boot logo (%d pages): %r", (INTN) Pages, Status);
+        return NULL;
+    }
+    Bmp = (UINT8 *) (UINTN) Where;
+
+    // Only now give back the previous one. Freeing it first and then failing to
+    // allocate would have thrown away a working boot logo to make room for one
+    // that was never made -- and the table would still be pointing at the memory
+    // that had just been released. Nothing can still be reading the old one: its
+    // only consumer is the system this is about to hand the machine to, and if
+    // that had happened this code would not be running.
+    if ((LastBmp != 0) && (LastPages > 0))
+        refit_call2_wrapper(BS->FreePages, LastBmp, LastPages);
+    LastBmp   = Where;
+    LastPages = Pages;
+
+    // Every one of the fifty-four bytes, written on purpose, including the ones
+    // that are zero.
+    //
+    // They were left to SetMem() first, and came out full of whatever the pages
+    // had held before -- a header correct in the fields this code wrote and
+    // wrong in the fields it did not, which is a memorable shape for a bug, and
+    // which Linux reported as "Unsupported BMP compression". Why the fill did
+    // not happen was never established; writing every byte on purpose is
+    // cheaper than finding out, and leaves nothing to depend on.
+    for (x = 0; x < BMP_HEADER_LENGTH; x++)
+        Bmp[x] = 0;
+    Bmp[0] = 'B'; Bmp[1] = 'M';
+    WriteU32(Bmp + 2, (UINT32) Bytes);            // 6: two reserved words, zero
+    WriteU32(Bmp + 10, BMP_HEADER_LENGTH);
+    WriteU32(Bmp + 14, 40);                       // BITMAPINFOHEADER
+    WriteU32(Bmp + 18, (UINT32) Image->Width);
+    WriteU32(Bmp + 22, (UINT32) Image->Height);   // positive: rows run bottom to top
+    Bmp[26] = 1; Bmp[27] = 0;                     // one plane
+    Bmp[28] = 24; Bmp[29] = 0;                    // 24 bits a pixel
+    WriteU32(Bmp + 30, 0);                        // no compression
+    WriteU32(Bmp + 34, (UINT32) (Stride * Image->Height));
+    WriteU32(Bmp + 38, 0);                        // pixels per metre, across
+    WriteU32(Bmp + 42, 0);                        // ...and down
+    WriteU32(Bmp + 46, 0);                        // no palette
+    WriteU32(Bmp + 50, 0);                        // ...and none of it important
+
+    for (y = 0; y < Image->Height; y++) {
+        EG_PIXEL *In = Image->PixelData + (Image->Height - 1 - y) * Image->Width;
+        Out = Bmp + BMP_HEADER_LENGTH + y * Stride;
+        for (x = 0; x < Image->Width; x++) {
+            *Out++ = In[x].b;
+            *Out++ = In[x].g;
+            *Out++ = In[x].r;
+        }
+        for (x = Row; x < Stride; x++)      // the row's padding, if it has any
+            *Out++ = 0;
+    }
+    *Size = Bytes;
+    return Bmp;
+} // UINT8 * MakeBmp()
+
+// Put Image where the firmware put its own logo, so whatever boots next shows
+// it. Silent and harmless when there is no table to write to: a machine whose
+// firmware publishes no BGRT simply keeps the boot screen it always had.
+VOID SetBootLogo(IN EG_IMAGE *Image) {
+    UINT8 *Bgrt, *Bmp;
+    UINTN  Size = 0;
+
+    if (!GlobalConfig.BgrtLogo || (Image == NULL))
+        return;
+
+    Bgrt = FindBgrt();
+    if (Bgrt == NULL) {
+        LOG(1, LOG_LINE_NORMAL, L"No BGRT table: the next system keeps its own boot logo");
+        return;
+    }
+    if (ReadU32(Bgrt + 4) < BGRT_LENGTH) {
+        LOG(1, LOG_LINE_NORMAL, L"BGRT table is too short to write to");
+        return;
+    }
+
+    Bmp = MakeBmp(Image, &Size);
+    if (Bmp == NULL)
+        return;
+
+    WriteU64(Bgrt + BGRT_IMAGE_ADDRESS, (UINT64) (UINTN) Bmp);
+    WriteU32(Bgrt + BGRT_OFFSET_X, 0);      // the picture is the whole screen
+    WriteU32(Bgrt + BGRT_OFFSET_Y, 0);
+    Bgrt[BGRT_IMAGE_TYPE] = 0;              // 0 means BMP, and 0 is all there is
+    // bit 0 says it is displayed; bits 1 and 2 are a rotation the firmware asked
+    // for, which applied to its own small logo and must not be applied to a
+    // picture that is already the shape of the screen.
+    Bgrt[BGRT_STATUS] = (UINT8) ((Bgrt[BGRT_STATUS] & ~((UINT8) 0x06)) | 0x01);
+    Reseal(Bgrt);
+
+    LOG(1, LOG_LINE_NORMAL, L"Boot logo handed on: %d x %d, %d KB at 0x%lx",
+        (INTN) Image->Width, (INTN) Image->Height, (INTN) (Size / 1024),
+        (UINT64) (UINTN) Bmp);
+} // VOID SetBootLogo()
