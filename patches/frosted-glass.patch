+// Step t of n, eased so it leaves quickly and arrives gently. Returns 0..256.
+static UINTN EaseOut(UINTN t, UINTN n) {
+    UINTN Left;
+
+    if ((n == 0) || (t >= n))
+        return 256;
+    Left = 256 - (256 * t) / n;
+    return 256 - (Left * Left * Left) / (256 * 256);
+}
