+static EG_IMAGE * ComposeMenuEntry(REFIT_MENU_ENTRY *Entry, BOOLEAN Selected,
+                                   UINTN XPos, UINTN YPos) {
+    if (Entry == NULL)
+        return NULL;
+    return ComposeTile(Entry->Image, Entry->BadgeImage, Entry->Row, Selected, XPos, YPos);
+}
