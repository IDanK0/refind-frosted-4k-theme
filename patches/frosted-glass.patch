 // Stores the results in the file-global variables egScreenWidth,
 // egScreenHeight, and egHasGraphics. The first two of these will be
 // unchanged if neither GraphicsOutput nor UgaDraw is a valid pointer.
+// Make the framebuffer fast to write.
+//
+// The firmware decides how the processor may cache the framebuffer, and a great
+// many of them leave it uncacheable. Uncacheable means every store goes to the
+// card on its own, one at a time, with no write buffering: a full 3840x2160
+// screen is 33 MB, and at those speeds putting one up takes long enough to watch
+// it happen from the top of the screen to the bottom. That wipe is not an
+// effect. It is the memory type.
+//
+// Write-combining is the memory type framebuffers are meant to have: stores are
+// gathered in the processor and sent as whole bursts. It is what every operating
+// system sets on the same memory once it takes over, and it is a ten-fold
+// difference on real hardware. The CPU architectural protocol is how a UEFI
+// program asks for it. If the firmware does not offer that protocol, or refuses,
+// nothing changes and nothing breaks -- the screen is simply as slow as it was.
+#define EFI_MEMORY_WC_ATTR  ((UINT64) 0x0000000000000002ULL)
+
+typedef struct _REFIND_CPU_ARCH_PROTOCOL REFIND_CPU_ARCH_PROTOCOL;
+struct _REFIND_CPU_ARCH_PROTOCOL {
+    VOID       *FlushDataCache;
+    VOID       *EnableInterrupt;
+    VOID       *DisableInterrupt;
+    VOID       *GetInterruptState;
+    VOID       *Init;
+    VOID       *RegisterInterruptHandler;
+    VOID       *GetTimerValue;
+    EFI_STATUS (EFIAPI *SetMemoryAttributes)(IN REFIND_CPU_ARCH_PROTOCOL *This,
+                                             IN EFI_PHYSICAL_ADDRESS BaseAddress,
+                                             IN UINT64 Length,
+                                             IN UINT64 Attributes);
+    UINT32      NumberOfTimers;
+    UINT32      DmaBufferAlignment;
+};
+
+static EFI_GUID CpuArchProtocolGuid = { 0x26baccb1, 0x6f42, 0x11d4,
+                                        { 0xbc, 0xe7, 0x00, 0x80, 0xc7, 0x3c, 0x88, 0x81 }};
+
+static UINT64 FastenedBase = 0;
+static UINT64 FastenedSize = 0;
+
+static VOID egSpeedUpFrameBuffer(VOID) {
+    REFIND_CPU_ARCH_PROTOCOL *Cpu = NULL;
+    EFI_STATUS                Status;
+    UINT64                    Size;
+
+    if ((GraphicsOutput == NULL) || (GraphicsOutput->Mode == NULL))
+        return;
+    if (GraphicsOutput->Mode->FrameBufferBase == 0)
+        return;
+    Size = (UINT64) GraphicsOutput->Mode->FrameBufferSize;
+    if (Size == 0)
+        return;
+    // Both, not just the address.
+    //
+    // The address is the aperture the card was given, and on every firmware
+    // worth the name it is the same for every mode. What changes when the mode
+    // changes is the size: the spec defines FrameBufferSize as the memory the
+    // *active* mode needs. Testing the address alone meant this ran once, at
+    // whatever resolution the firmware powered up in -- 800x600 in the test
+    // machine, 1024x768 on plenty of real ones -- and marked two or three
+    // megabytes as write-combining. The menu then switched to the mode it wanted
+    // and drew thirty-three megabytes a screen, all but the first three of them
+    // through uncached memory, and the guard said the work was already done.
+    if ((GraphicsOutput->Mode->FrameBufferBase == FastenedBase) && (Size == FastenedSize))
+        return;                     // asked already, for this mode
+    FastenedBase = GraphicsOutput->Mode->FrameBufferBase;
+    FastenedSize = Size;
+    Status = LibLocateProtocol(&CpuArchProtocolGuid, (VOID **) &Cpu);
+    if (EFI_ERROR(Status) || (Cpu == NULL) || (Cpu->SetMemoryAttributes == NULL))
+        return;
+    Status = refit_call4_wrapper(Cpu->SetMemoryAttributes, Cpu,
+                                 GraphicsOutput->Mode->FrameBufferBase,
+                                 Size, EFI_MEMORY_WC_ATTR);
+    LOG(1, LOG_LINE_NORMAL, L"Framebuffer write-combining: %r", Status);
+} // VOID egSpeedUpFrameBuffer()
