+// Put pixels on the screen without going through the firmware.
+//
+// GraphicsOutput->Blt() is firmware code that touches every pixel, and at
+// 3840x2160 a whole screen is eight million of them. But the GOP also publishes
+// where the framebuffer actually is, and when its format is BGRX -- which is
+// what essentially every machine reports, and exactly the layout EG_PIXEL
+// already uses -- a row of an image is a row of the screen and the whole
+// operation is one memory copy per line.
+//
+// Everything is checked before taking this path: the format, that there is a
+// framebuffer address at all, and that the rectangle is inside the screen. When
+// any of it does not hold, the firmware's own Blt() is used exactly as before.
+// A copy that moves eight bytes at a time.
+//
+// gnu-efi's CopyMem() ends in a memcpy() that is a byte-at-a-time loop: load a
+// byte, store a byte, increment, compare. Against ordinary memory that is
+// eleven times slower than it needs to be. Against a framebuffer it is far
+// worse than that, because a framebuffer is not ordinary memory: every store
+// leaves the processor for the graphics card, and one byte per journey means
+// 33 million journeys to put up a single 3840x2160 screen. That is the wipe
+// from the top of the screen to the bottom, and it is measured in seconds.
+//
+// Eight bytes per store is eight times fewer journeys. rEFInd is built with
+// -fno-tree-loop-distribute-patterns, so the compiler leaves this loop alone
+// rather than turning it back into the memcpy() it came from.
+static VOID egCopyWide(OUT UINT8 *Dest, IN UINT8 *Src, IN UINTN Count) {
+    UINTN i, Whole;
+
+    if ((((UINTN) Dest | (UINTN) Src) & 7) == 0) {
+        UINT64 *D = (UINT64 *) Dest, *S = (UINT64 *) Src;
+        Whole = Count >> 3;
+        for (i = 0; i < Whole; i++)
+            D[i] = S[i];
+        i = Whole << 3;
+    } else {
+        // pixels are always four-byte aligned even when the row start is not
+        UINT32 *D = (UINT32 *) Dest, *S = (UINT32 *) Src;
+        Whole = Count >> 2;
+        for (i = 0; i < Whole; i++)
+            D[i] = S[i];
+        i = Whole << 2;
+    }
+    for (; i < Count; i++)
+        Dest[i] = Src[i];
+} // VOID egCopyWide()
+
+// May this area be reached by touching the framebuffer directly? Only when the
+// firmware laid the screen out the way EG_IMAGE already stores pixels, and only
+// inside the screen.
+static BOOLEAN egFrameBufferUsable(IN UINTN Width, IN UINTN Height,
+                                   IN UINTN ScreenPosX, IN UINTN ScreenPosY) {
+    if ((GraphicsOutput == NULL) || (GraphicsOutput->Mode == NULL) ||
+        (GraphicsOutput->Mode->Info == NULL))
+        return FALSE;
+    if (GraphicsOutput->Mode->Info->PixelFormat != PixelBlueGreenRedReserved8BitPerColor)
+        return FALSE;
+    if (GraphicsOutput->Mode->FrameBufferBase == 0)
+        return FALSE;
+    if (GraphicsOutput->Mode->Info->PixelsPerScanLine < egScreenWidth)
+        return FALSE;
+    if ((ScreenPosX + Width > egScreenWidth) ||
+        (ScreenPosY + Height > egScreenHeight))
+        return FALSE;
+    return TRUE;
+} // BOOLEAN egFrameBufferUsable()
+
+static BOOLEAN egDirectDraw(IN EG_IMAGE *Image,
+                            IN UINTN AreaPosX, IN UINTN AreaPosY,
+                            IN UINTN AreaWidth, IN UINTN AreaHeight,
+                            IN UINTN ScreenPosX, IN UINTN ScreenPosY) {
+    UINT8 *Base;
+    UINTN  Stride, y;
+
+    if (!egFrameBufferUsable(AreaWidth, AreaHeight, ScreenPosX, ScreenPosY))
+        return FALSE;
+
+    Stride = (UINTN) GraphicsOutput->Mode->Info->PixelsPerScanLine * 4;
+    Base   = (UINT8 *) (UINTN) GraphicsOutput->Mode->FrameBufferBase;
+    for (y = 0; y < AreaHeight; y++) {
+        egCopyWide(Base + (ScreenPosY + y) * Stride + ScreenPosX * 4,
+                   (UINT8 *) (Image->PixelData + (AreaPosY + y) * Image->Width + AreaPosX),
+                   AreaWidth * 4);
+    }
+    return TRUE;
+} // BOOLEAN egDirectDraw()
