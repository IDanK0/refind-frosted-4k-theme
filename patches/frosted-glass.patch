+static VOID BlendBlit(IN EG_IMAGE *From, IN EG_IMAGE *To, IN UINTN Alpha,
+                      IN UINTN XPos, IN UINTN YPos) {
+    EG_IMAGE *Mix;
+    UINTN     i, Count, Rev;
+
+    if ((From == NULL) || (To == NULL))
+        return;
+    if (Alpha >= 256) { BltImage(To, XPos, YPos);   return; }
+    if (Alpha == 0)   { BltImage(From, XPos, YPos); return; }
+    if ((From->Width != To->Width) || (From->Height != To->Height))
+        return;
+    Mix = egCreateImage(From->Width, From->Height, FALSE);
+    if (Mix == NULL)
