+// The selection moving: the highlight fades off one tile and onto the other.
+// What is already on the screen is read back rather than recomposed, so this
+// costs the same two blurs the instant version always cost.
+static VOID AnimateSelection(IN REFIT_MENU_ENTRY *Old, IN UINTN OX, IN UINTN OY,
+                             IN REFIT_MENU_ENTRY *New, IN UINTN NX, IN UINTN NY) {
+    EG_IMAGE *WasOld, *WasNew, *ToOld, *ToNew;
+    UINTN     f, Alpha;
+    UINT64    Began, Span;
