+        for (;;) {
+            UINT64 FrameAt = NowUs();
+            UINT64 Gone    = FrameAt - Began;
+            if (Gone >= Span)
+                break;
+            f = 1 + (UINTN) ((Gone * ANIM_SEL_FRAMES) / Span);
+            Alpha = EaseOut(f, ANIM_SEL_FRAMES);
+            BlendBlit(WasOld, ToOld, Alpha, OX, OY);
+            BlendBlit(WasNew, ToNew, Alpha, NX, NY);
+            if (!HoldFrame(FrameAt, ANIM_FRAME_US, TRUE))
+                break;
+        }
+        BltImage(ToOld, OX, OY);
+        BltImage(ToNew, NX, NY);
+        egFreeImage(WasOld);
+        egFreeImage(WasNew);
+    }
+    egFreeImage(ToOld);
+    egFreeImage(ToNew);
+    ChosenX = NX; ChosenY = NY; ChosenKnown = TRUE;
+} // VOID AnimateSelection()
