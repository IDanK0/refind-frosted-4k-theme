+    if (Size < 3)
+        return NULL;
+    Image = egCreateImage(Size, Size, TRUE);
+    if (Image == NULL)
+        return NULL;
+    R2 = 16 * (INTN) Size * (INTN) Size;          // radius Size/2, in eighths of a pixel
+    for (y = 0; y < Size; y++) {
+        for (x = 0; x < Size; x++) {
+            Hits = 0;
+            for (sy = 0; sy < 4; sy++) {
+                for (sx = 0; sx < 4; sx++) {
+                    dx = (INTN) (8 * x + 2 * sx + 1) - 4 * (INTN) Size;
+                    dy = (INTN) (8 * y + 2 * sy + 1) - 4 * (INTN) Size;
+                    if (dx * dx + dy * dy <= R2)
+                        Hits++;
+                }
+            }
+            i = y * Size + x;
+            Image->PixelData[i].r = 255;
+            Image->PixelData[i].g = 255;
+            Image->PixelData[i].b = 255;
+            Image->PixelData[i].a = (UINT8) ((Hits * 255) / 16);
