--- a/refind/theme.c	1970-01-01 01:00:00.000000000 +0100
+++ b/refind/theme.c	2026-08-31 03:09:22.694071442 +0200
@@ -0,0 +1,959 @@
+/*
+ * refind/theme.c
+ * Choosing and applying the look, from inside the boot menu.
+ *
+ * Everything here used to be done by a Python program on the installed Linux,
+ * which meant the boot menu could only be re-themed from one particular
+ * operating system -- an odd dependency for the thing that starts all of them.
+ * The shapes are still drawn ahead of time, because drawing rounded glass and
+ * compositing forty-seven logos is not work for a bootloader. The colours are
+ * not: they are read off the photograph here, at boot, so a picture dropped into
+ * EFI\refind\backgrounds from anything at all -- including Windows -- is themed
+ * exactly like the ones that shipped.
+ *
+ * There is no floating point in an EFI application, and no trigonometry either.
+ * Neither is needed: see SampleAccent().
+ */
+
+#include "global.h"
+#include "screen.h"
+#include "lib.h"
+#include "menu.h"
+#include "theme.h"
+#include "icns.h"
+#include "mystrings.h"
+#include "log.h"
+#include "../include/refit_call_wrapper.h"
+
+#define BACKGROUND_DIR   L"backgrounds"
+#define THEME_FILE       L"theme.conf"
+#define RAMP_STEPS       (256)
+#define DARKEN_AUTO      (101)
+#define TARGET_LUMINANCE (30)
+
+// The ends of the ramp a logo is laid along, and how much colour it may carry.
+#define RAMP_DARK        (46)
+#define RAMP_LIGHT       (219)
+#define CHROMA_FLOOR     (20)
+#define CHROMA_CEILING   (52)
+// How much of the peak chroma the ends of the ramp keep, in 255ths. Not zero: a
+// duotone whose chroma vanishes at both ends turns everything white back into
+// grey, and the white things here -- the names, the rim of the glass, the dots
+// of the spinner -- are most of what carries the colour.
+#define RAMP_END         (107)
+
+static EG_PIXEL  Ramp[RAMP_STEPS];
+static BOOLEAN   RampReady = FALSE;
+
+// The artwork exactly as it was loaded. Everything is tinted from these, never
+// from the last tint, so moving a setting back and forth cannot compound.
+static EG_IMAGE  **PristineIcons = NULL;
+static UINTN       PristineCount = 0;
+static EG_IMAGE   *PristineBackground = NULL;
+static CHAR16     *PristineName = NULL;
+
+static INTN AbsI(INTN x) { return (x < 0) ? -x : x; }
+
+// Integer square root.
+//
+// The guard on the first line is not defensive dressing: without it a negative n
+// sends `while (b > n)` shifting b down to zero, where 0 > n is still true and
+// the loop never ends. That is a bootloader that hangs after drawing the
+// background and never gets as far as the menu, which is exactly what it did.
+static INTN SquareRoot(INTN n) {
+    INTN r = 0, b = ((INTN) 1) << 62;
+
+    if (n <= 0)
+        return 0;
+    while (b > n)
+        b >>= 2;
+    while (b > 0) {
+        if (n >= r + b) { n -= r + b; r = (r >> 1) + b; }
+        else            { r >>= 1; }
+        b >>= 2;
+    }
+    return r;
+}
+
+//
+// The photograph's colour, with no sine anywhere
+//
+// Averaging hues is the whole difficulty: hue is an angle, opposite angles
+// cancel, and a straight mean of them comes out grey. The usual answer is to
+// average points on a circle, which needs trigonometry that an EFI application
+// has no business carrying.
+//
+// It is not needed. Every colour is a grey plus a departure from grey, and that
+// departure lives in the plane at right angles to the grey axis. Averaging the
+// departures IS the circular mean of the hues, written in linear coordinates --
+// so a sum of three integers per pixel replaces the whole of it.
+//
+// Brightness is cubed in the weight. With brightness counting once, a vast dark
+// dune outvotes the small bright sky that the eye actually reads the picture by,
+// and the answer comes out a colour that is nowhere in the photograph.
+//
+static VOID SampleAccent(IN EG_IMAGE *Image, OUT INTN *Dir, OUT INTN *Chroma) {
+    UINTN     x, y, Step;
+    INTN      Ax = 0, Ay = 0, Az = 0, dx, dy, dz, Len;
+    INTN      r, g, b, Hi, Lo, Mid, c, v, w;
+    INT64     Weight = 0, ChromaSum = 0, Count = 0;
+    EG_PIXEL *P;
+
+    Dir[0] = Dir[1] = Dir[2] = 0;
+    *Chroma = 0;
+    if ((Image == NULL) || (Image->Width < 8) || (Image->Height < 8))
+        return;
+
+    // about 60,000 samples whatever the picture's size
+    Step = (Image->Width * Image->Height) / 60000;
+    if (Step < 1)
+        Step = 1;
+
+    for (y = 0; y < Image->Height; y++) {
+        for (x = 0; x < Image->Width; x += Step) {
+            P = &Image->PixelData[y * Image->Width + x];
+            r = P->r; g = P->g; b = P->b;
+            Hi = (r > g) ? ((r > b) ? r : b) : ((g > b) ? g : b);
+            Lo = (r < g) ? ((r < b) ? r : b) : ((g < b) ? g : b);
+            c = Hi - Lo;
+            v = Hi;
+            if ((c < 6) || (v < 8))
+                continue;
+            // colourful, and bright, with brightness counting for much more
+            w = ((c * c) / 256 + 1) * ((v * v * v) / 65536 + 1);
+            Mid = (r + g + b) / 3;
+            dx = r - Mid; dy = g - Mid; dz = b - Mid;
+            Len = SquareRoot(dx * dx + dy * dy + dz * dz);
+            if (Len < 1)
+                continue;
+            // the direction only: a vivid pixel and a pale one of the same hue
+            // should agree, and it is the weight's job to say which counts more
+            Ax += (dx * w) / Len;
+            Ay += (dy * w) / Len;
+            Az += (dz * w) / Len;
+            Count++;
+            Weight += w;
+            ChromaSum += (INT64) c * w;
+        } // for x
+    } // for y
+
+    if ((Weight < 1) || (Count < 1))
+        return;
+    // Bring the sums back down before squaring them. Sixty thousand samples of
+    // up to a few million each square to more than a 64-bit integer holds, and
+    // the wrap makes the length negative -- which used to be a hang and is now
+    // merely wrong, so it must not happen at all.
+    Ax = (INTN) (Ax / Count);
+    Ay = (INTN) (Ay / Count);
+    Az = (INTN) (Az / Count);
+    Len = SquareRoot(Ax * Ax + Ay * Ay + Az * Az);
+    if (Len < 1)
+        return;
+    Dir[0] = (Ax * 1024) / Len;
+    Dir[1] = (Ay * 1024) / Len;
+    Dir[2] = (Az * 1024) / Len;
+    *Chroma = (INTN) (ChromaSum / Weight);
+} // VOID SampleAccent()
+
+// The ramp a logo is laid along: dark at the bottom of its own range, light at
+// the top, and the colour fullest in the middle. A straight line between a dark
+// colour and a light one passes through their average, which is close to grey,
+// and the middle of the range is exactly where a logo sits -- so a straight ramp
+// takes the colour out of the one part anybody looks at.
+static VOID BuildRamp(IN INTN *Dir, IN INTN Chroma) {
+    UINTN i;
+    INTN  t, v, peak, u, s, comp, k;
+
+    peak = (Chroma * 45) / 100;
+    if (peak < CHROMA_FLOOR)   peak = CHROMA_FLOOR;
+    if (peak > CHROMA_CEILING) peak = CHROMA_CEILING;
+
+    for (i = 0; i < RAMP_STEPS; i++) {
+        t = (INTN) i;
+        v = RAMP_DARK + ((RAMP_LIGHT - RAMP_DARK) * t) / 255;
+        u = 255 - AbsI(2 * t - 255);            // a triangle, peaking at the middle
+        s = (u * (510 - u)) / 255;              // broadened, so the top is flat-ish
+        if (s > 255) s = 255;
+        s = RAMP_END + ((255 - RAMP_END) * s) / 255;   // and never all the way down
+        for (k = 0; k < 3; k++) {
+            comp = v + (Dir[k] * peak * s) / (1024 * 255);
+            if (comp < 0)   comp = 0;
+            if (comp > 255) comp = 255;
+            if (k == 0) Ramp[i].r = (UINT8) comp;
+            if (k == 1) Ramp[i].g = (UINT8) comp;
+            if (k == 2) Ramp[i].b = (UINT8) comp;
+        }
+        Ramp[i].a = 0;
+    }
+    RampReady = TRUE;
+} // VOID BuildRamp()
+
+// Lay an image along the ramp by its own lightness, then mix that back with the
+// original. The shape and its internal contrast are untouched; only the colour
+// moves. Strength 0 returns the artwork as it was drawn -- Windows blue, Ubuntu
+// orange -- which is what turning the setting off has to mean.
+static EG_IMAGE * TintCopy(IN EG_IMAGE *Src, IN UINTN Strength) {
+    EG_IMAGE *Out;
+    UINTN     i, n, Rev;
+    INTN      lum;
+
+    if (Src == NULL)
+        return NULL;
+    Out = egCopyImage(Src);
+    if ((Out == NULL) || (Strength == 0) || !RampReady)
+        return Out;
+    if (Strength > 100)
+        Strength = 100;
+    Rev = 100 - Strength;
+    n = Out->Width * Out->Height;
+    for (i = 0; i < n; i++) {
+        lum = (77 * (INTN) Out->PixelData[i].r + 151 * (INTN) Out->PixelData[i].g +
+               28 * (INTN) Out->PixelData[i].b) >> 8;
+        if (lum > 255) lum = 255;
+        Out->PixelData[i].r = (UINT8) (((UINTN) Out->PixelData[i].r * Rev +
+                                        (UINTN) Ramp[lum].r * Strength) / 100);
+        Out->PixelData[i].g = (UINT8) (((UINTN) Out->PixelData[i].g * Rev +
+                                        (UINTN) Ramp[lum].g * Strength) / 100);
+        Out->PixelData[i].b = (UINT8) (((UINTN) Out->PixelData[i].b * Rev +
+                                        (UINTN) Ramp[lum].b * Strength) / 100);
+    }
+    return Out;
+} // EG_IMAGE * TintCopy()
+
+// Mean lightness of the strip the tiles sit on, which is the only part whose
+// brightness decides whether the glass and the names can be read.
+static UINTN BandLuminance(IN EG_IMAGE *Image) {
+    UINTN  x, y, y0, y1, Count = 0;
+    INT64  Sum = 0;
+
+    if ((Image == NULL) || (Image->Height < 16))
+        return 128;
+    y0 = (Image->Height * 40) / 100;
+    y1 = (Image->Height * 65) / 100;
+    for (y = y0; y < y1; y += 4) {
+        for (x = 0; x < Image->Width; x += 8) {
+            EG_PIXEL *P = &Image->PixelData[y * Image->Width + x];
+            Sum += (77 * P->r + 151 * P->g + 28 * P->b) >> 8;
+            Count++;
+        }
+    }
+    return (Count > 0) ? (UINTN) (Sum / Count) : 128;
+} // UINTN BandLuminance()
+
+static VOID DarkenImage(IN OUT EG_IMAGE *Image, IN UINTN Percent) {
+    UINTN i, n, Keep;
+
+    if ((Image == NULL) || (Percent == 0))
+        return;
+    if (Percent > 100)
+        Percent = 100;
+    Keep = 100 - Percent;
+    n = Image->Width * Image->Height;
+    for (i = 0; i < n; i++) {
+        Image->PixelData[i].r = (UINT8) (((UINTN) Image->PixelData[i].r * Keep) / 100);
+        Image->PixelData[i].g = (UINT8) (((UINTN) Image->PixelData[i].g * Keep) / 100);
+        Image->PixelData[i].b = (UINT8) (((UINTN) Image->PixelData[i].b * Keep) / 100);
+    }
+} // VOID DarkenImage()
+
+// Remember the artwork as it arrived, once, so every later tint starts from it.
+//
+// These are BORROWED, never owned. A tool's icon comes from BuiltinIcon(), which
+// hands back the pointer in its own cache rather than a copy -- and several
+// tools can be handed the same one. Freeing what is in an entry is therefore
+// freeing somebody else's image, twice over for a shared one, and a corrupted
+// heap turns every later allocation into a failure. Which is what emptied the
+// menu: every icon came back NULL and every tile drew as bare background.
+static VOID KeepPristine(VOID) {
+    UINTN i;
+
+    if (PristineIcons != NULL)
+        return;
+    PristineCount = MainMenu.EntryCount;
+    if (PristineCount == 0)
+        return;
+    PristineIcons = AllocateZeroPool(PristineCount * sizeof(EG_IMAGE *));
+    if (PristineIcons == NULL) {
+        PristineCount = 0;
+        return;
+    }
+    for (i = 0; i < PristineCount; i++)
+        PristineIcons[i] = MainMenu.Entries[i]->Image;
+} // VOID KeepPristine()
+
+//
+// Put the current settings on the screen
+//
+VOID ApplyTheme(VOID) {
+    EG_IMAGE *Loaded, *Scaled;
+    CHAR16   *Path;
+    UINTN     i, Darken, Lum;
+    INTN      Dir[3], Chroma;
+
+    if (!AllowGraphicsMode)
+        return;
+
+    // the photograph, kept as decoded so dimming is never applied twice
+    if ((GlobalConfig.BackgroundFile != NULL) &&
+        ((PristineName == NULL) || !MyStriCmp(PristineName, GlobalConfig.BackgroundFile))) {
+        Path = PoolPrint(L"%s\\%s", BACKGROUND_DIR, GlobalConfig.BackgroundFile);
+        if (Path != NULL) {
+            Loaded = egLoadImage(SelfDir, Path, FALSE);
+            MyFreePool(Path);
+            if (Loaded != NULL) {
+                if ((Loaded->Width != UGAWidth) || (Loaded->Height != UGAHeight)) {
+                    Scaled = egScaleImage(Loaded, UGAWidth, UGAHeight);
+                    if (Scaled != NULL) { egFreeImage(Loaded); Loaded = Scaled; }
+                }
+                egFreeImage(PristineBackground);
+                PristineBackground = Loaded;
+                MyFreePool(PristineName);
+                PristineName = StrDuplicate(GlobalConfig.BackgroundFile);
+            } else {
+                LOG(1, LOG_LINE_NORMAL, L"Could not load background '%s'",
+                    GlobalConfig.BackgroundFile);
+            }
+        }
+    }
+    if (PristineBackground == NULL)
+        return;
+
+    Darken = GlobalConfig.Darken;
+    if (Darken == DARKEN_AUTO) {
+        Lum = BandLuminance(PristineBackground);
+        Darken = (Lum <= TARGET_LUMINANCE) ? 0 : (100 - (TARGET_LUMINANCE * 100) / Lum);
+        if (Darken < 5)
+            Darken = 0;
+    }
+
+    egFreeImage(ThemeBanner);
+    ThemeBanner = egCopyImage(PristineBackground);
+    DarkenImage(ThemeBanner, Darken);
+    egFreeImage(GlobalConfig.ScreenBackground);
+    GlobalConfig.ScreenBackground = egCopyImage(ThemeBanner);
+
+    SampleAccent(ThemeBanner, Dir, &Chroma);
+    BuildRamp(Dir, Chroma);
+    LOG(1, LOG_LINE_NORMAL, L"Theme: background '%s', dim %d%%, chroma %d, tint %d%%",
+        GlobalConfig.BackgroundFile ? GlobalConfig.BackgroundFile : L"(banner)",
+        Darken, Chroma, GlobalConfig.Tint);
+
+    KeepPristine();
+    for (i = 0; (i < PristineCount) && (i < MainMenu.EntryCount); i++) {
+        EG_IMAGE *Fresh;
+
+        if (PristineIcons[i] == NULL)
+            continue;
+        if (GlobalConfig.Tint == 0) {
+            Fresh = PristineIcons[i];              // the artwork as drawn
+        } else {
+            Fresh = TintCopy(PristineIcons[i], GlobalConfig.Tint);
+            if (Fresh == NULL)
+                continue;                          // leave what is there: an
+                                                   // entry must never lose its icon
+        }
+        // only ever free a copy this function made
+        if ((MainMenu.Entries[i]->Image != PristineIcons[i]) &&
+            (MainMenu.Entries[i]->Image != Fresh))
+            egFreeImage(MainMenu.Entries[i]->Image);
+        MainMenu.Entries[i]->Image = Fresh;
+    }
+    ResetTheming();
+} // VOID ApplyTheme()
+
+// Let go of the borrowed icon pointers. RescanAll() frees every menu entry and
+// builds new ones, so anything remembered from before that is a pointer into
+// memory somebody else has handed back.
+VOID ThemeForgetIcons(VOID) {
+    MyFreePool(PristineIcons);
+    PristineIcons = NULL;
+    PristineCount = 0;
+} // VOID ThemeForgetIcons()
+
+#define FADE_FRAMES (7)
+#define FADE_STALL  (12000)
+
+// The picture arriving, and leaving.
+//
+// rEFInd used to paint the whole screen three times before the menu appeared:
+// once in SetupScreen(), once more after the scan, and a clear to black in
+// between. At 3840x2160 each of those is a third of a second of visible wiping,
+// so what you saw was a wipe, a pause, a black flash and another wipe. Now the
+// screen stays black until there is something worth showing, and then the
+// picture comes up once, out of the black.
+static VOID FadeBanner(IN BOOLEAN In) {
+    EG_IMAGE *From, *Mix;
+    UINTN     f, i, n, Alpha, Step;
+
+    From = In ? ThemeBanner : egCopyScreen();
+    if (From == NULL)
+        return;
+    Mix = egCreateImage(From->Width, From->Height, FALSE);
+    if (Mix == NULL) {
+        if (!In) egFreeImage(From);
+        return;
+    }
+    n = Mix->Width * Mix->Height;
+    for (f = 1; f <= FADE_FRAMES; f++) {
+        Step = In ? f : (FADE_FRAMES - f);
+        Alpha = (256 * Step) / FADE_FRAMES;
+        for (i = 0; i < n; i++) {
+            Mix->PixelData[i].r = (UINT8) (((UINTN) From->PixelData[i].r * Alpha) >> 8);
+            Mix->PixelData[i].g = (UINT8) (((UINTN) From->PixelData[i].g * Alpha) >> 8);
+            Mix->PixelData[i].b = (UINT8) (((UINTN) From->PixelData[i].b * Alpha) >> 8);
+            Mix->PixelData[i].a = 0;
+        }
+        BltImage(Mix, 0, 0);
+        refit_call1_wrapper(BS->Stall, FADE_STALL);
+    }
+    egFreeImage(Mix);
+    if (!In)
+        egFreeImage(From);
+} // VOID FadeBanner()
+
+// The one paint that replaces the three. Called once the theme knows what it is
+// drawing, so the picture that comes up is the final one.
+VOID ThemeFadeIn(VOID) {
+    EG_PIXEL Black = { 0, 0, 0, 0 };
+
+    if (!AllowGraphicsMode)
+        return;
+    SwitchToGraphics();
+    if (GlobalConfig.Animations && (ThemeBanner != NULL)) {
+        egClearScreen(&Black);
+        FadeBanner(TRUE);
+    }
+    BltClearScreen(TRUE);      // the final frame, and it records ScreenBackground
+} // VOID ThemeFadeIn()
+
+// Going the other way, so an operating system is not handed a screen that
+// snapped to black on the last frame of an animation.
+VOID ThemeFadeOut(VOID) {
+    EG_PIXEL Black = { 0, 0, 0, 0 };
+
+    if (AllowGraphicsMode && GlobalConfig.Animations)
+        FadeBanner(FALSE);
+    egClearScreen(&Black);
+} // VOID ThemeFadeOut()
+
+// Reachable from menu.c, which owns the selection images and the spinner dot.
+EG_IMAGE * ThemeTint(IN EG_IMAGE *Source) {
+    return TintCopy(Source, GlobalConfig.Tint);
+} // EG_IMAGE * ThemeTint()
+
+//
+// A panel of the same glass the menu is made of
+//
+// rEFInd's own sub-menus are a flat grey rectangle with a line of text in it,
+// which is fine and looks nothing like the rest of this. Everything below draws
+// them the way the tiles are drawn: the photograph frosted behind a rounded
+// pane, a lit rim, the theme's colours, and the selected row on a rounded bar.
+// One style function serves all of them -- settings, about, hidden tags, the
+// boot-options sub-screens -- so there is no second appearance to keep in step.
+//
+
+#define PANEL_GLASS  (26)     // the pane's own tint
+#define PANEL_RIM    (205)    // its lit edge
+#define PANEL_HAIR   (150)    // the hairline just inside the top
+#define PANEL_PAD_X  (3)      // padding, in font cells
+#define PANEL_PAD_Y  (1)      // padding, in text lines
+#define PANEL_FADE   (4)
+
+static UINTN PanelX, PanelY, PanelW, PanelH, RowH, RowTop, RowsCount;
+static EG_IMAGE *PanelShown = NULL;
+
+static EG_PIXEL RampAt(UINTN i) {
+    EG_PIXEL White = { 0xff, 0xff, 0xff, 0 };
+    if (!RampReady)
+        return White;
+    return Ramp[(i > 255) ? 255 : i];
+} // EG_PIXEL RampAt()
+
+// Coverage of a rounded rectangle, written into an alpha channel. Only the four
+// corners are sampled: everything between them is covered, and sampling a whole
+// panel sixteen times per pixel to learn that would cost more than the panel.
+static VOID RoundedAlpha(IN OUT EG_IMAGE *Image, IN UINTN Radius) {
+    UINTN x, y, sx, sy, Hits, cx, cy, W, H;
+    INTN  dx, dy, R2;
+
+    if (Image == NULL)
+        return;
+    W = Image->Width; H = Image->Height;
+    if (Radius * 2 > W) Radius = W / 2;
+    if (Radius * 2 > H) Radius = H / 2;
+    for (y = 0; y < H; y++)
+        for (x = 0; x < W; x++)
+            Image->PixelData[y * W + x].a = 255;
+    if (Radius < 2)
+        return;
+    // In eighths of a pixel: the corner's centre sits at 8*Radius and its radius
+    // is 8*Radius, so the square of it is 64*Radius*Radius. Sixteen would be a
+    // corner of half the size, which leaves the outside of the corner box
+    // uncovered -- a rounded rectangle with the corners bitten out of it.
+    R2 = 64 * (INTN) Radius * (INTN) Radius;
+    for (y = 0; y < Radius; y++) {
+        for (x = 0; x < Radius; x++) {
+            Hits = 0;
+            for (sy = 0; sy < 4; sy++) {
+                for (sx = 0; sx < 4; sx++) {
+                    dx = (INTN) (8 * x + 2 * sx + 1) - 8 * (INTN) Radius;
+                    dy = (INTN) (8 * y + 2 * sy + 1) - 8 * (INTN) Radius;
+                    if (dx * dx + dy * dy <= R2)
+                        Hits++;
+                }
+            }
+            for (cy = 0; cy < 2; cy++) {
+                for (cx = 0; cx < 2; cx++) {
+                    UINTN px = cx ? (W - 1 - x) : x;
+                    UINTN py = cy ? (H - 1 - y) : y;
+                    Image->PixelData[py * W + px].a = (UINT8) ((Hits * 255) / 16);
+                }
+            }
+        }
+    }
+} // VOID RoundedAlpha()
+
+// Lay a colour over an image through a mask, at a given strength.
+static VOID Wash(IN OUT EG_IMAGE *Dest, IN EG_IMAGE *Mask, IN EG_PIXEL Colour,
+                 IN UINTN Alpha) {
+    UINTN i, n, a;
+
+    if ((Dest == NULL) || (Mask == NULL))
+        return;
+    n = Dest->Width * Dest->Height;
+    for (i = 0; i < n; i++) {
+        a = ((UINTN) Mask->PixelData[i].a * Alpha) / 255;
+        if (a == 0)
+            continue;
+        Dest->PixelData[i].r = (UINT8) (((UINTN) Dest->PixelData[i].r * (255 - a) +
+                                         (UINTN) Colour.r * a) / 255);
+        Dest->PixelData[i].g = (UINT8) (((UINTN) Dest->PixelData[i].g * (255 - a) +
+                                         (UINTN) Colour.g * a) / 255);
+        Dest->PixelData[i].b = (UINT8) (((UINTN) Dest->PixelData[i].b * (255 - a) +
+                                         (UINTN) Colour.b * a) / 255);
+    }
+} // VOID Wash()
+
+// A ring: a rounded rectangle with a smaller one subtracted from the middle of
+// it. The inner one is built at its own smaller size and read with an offset --
+// building both at full size and trying to shift one while subtracting is how
+// the corners came out notched.
+static EG_IMAGE * RimMask(IN UINTN W, IN UINTN H, IN UINTN Radius, IN UINTN Width) {
+    EG_IMAGE *Outer, *Inner;
+    UINTN     x, y, a, b;
+
+    if ((W <= 2 * Width) || (H <= 2 * Width))
+        return NULL;
+    Outer = egCreateImage(W, H, TRUE);
+    Inner = egCreateImage(W - 2 * Width, H - 2 * Width, TRUE);
+    if ((Outer == NULL) || (Inner == NULL)) {
+        egFreeImage(Outer); egFreeImage(Inner);
+        return NULL;
+    }
+    RoundedAlpha(Outer, Radius);
+    RoundedAlpha(Inner, (Radius > Width) ? Radius - Width : 0);
+    for (y = 0; y < H; y++) {
+        for (x = 0; x < W; x++) {
+            a = Outer->PixelData[y * W + x].a;
+            b = 0;
+            if ((x >= Width) && (y >= Width) &&
+                (x < W - Width) && (y < H - Width))
+                b = Inner->PixelData[(y - Width) * Inner->Width + (x - Width)].a;
+            Outer->PixelData[y * W + x].a = (UINT8) ((a > b) ? a - b : 0);
+        }
+    }
+    egFreeImage(Inner);
+    return Outer;
+} // EG_IMAGE * RimMask()
+
+// The pane itself: the photograph frosted where the glass is, tinted, and rimmed.
+static EG_IMAGE * MakePanel(VOID) {
+    EG_IMAGE *Panel, *Shape, *Rim;
+    UINTN     Radius;
+
+    Panel = egCropImage(GlobalConfig.ScreenBackground, PanelX, PanelY, PanelW, PanelH);
+    if (Panel == NULL)
+        return NULL;
+    Radius = RowH;
+    if (Radius > PanelH / 4) Radius = PanelH / 4;
+
+    Shape = egCreateImage(PanelW, PanelH, TRUE);
+    if (Shape != NULL) {
+        RoundedAlpha(Shape, Radius);
+        egFrostImage(Panel, Shape, GlobalConfig.FrostRadius);
+        Wash(Panel, Shape, RampAt(255), PANEL_GLASS);
+    }
+    Rim = RimMask(PanelW, PanelH, Radius, 3);
+    if (Rim != NULL) {
+        Wash(Panel, Rim, RampAt(255), PANEL_RIM);
+        egFreeImage(Rim);
+    }
+    Rim = RimMask(PanelW, PanelH, (Radius > 6) ? Radius - 6 : 1, 1);
+    if (Rim != NULL) {
+        UINTN x, y;
+        // only the top half catches the bevel
+        for (y = PanelH / 2; y < PanelH; y++)
+            for (x = 0; x < PanelW; x++)
+                Rim->PixelData[y * PanelW + x].a = 0;
+        Wash(Panel, Rim, RampAt(255), PANEL_HAIR);
+        egFreeImage(Rim);
+    }
+    egFreeImage(Shape);
+    return Panel;
+} // EG_IMAGE * MakePanel()
+
+// Lay a colour through a mask that covers only part of the panel.
+static VOID WashArea(IN OUT EG_IMAGE *Dest, IN EG_IMAGE *Mask, IN UINTN AtX,
+                     IN UINTN AtY, IN EG_PIXEL Colour, IN UINTN Alpha) {
+    UINTN x, y, a, i, j;
+
+    if ((Dest == NULL) || (Mask == NULL))
+        return;
+    for (y = 0; (y < Mask->Height) && (AtY + y < Dest->Height); y++) {
+        for (x = 0; (x < Mask->Width) && (AtX + x < Dest->Width); x++) {
+            a = ((UINTN) Mask->PixelData[y * Mask->Width + x].a * Alpha) / 255;
+            if (a == 0)
+                continue;
+            i = (AtY + y) * Dest->Width + (AtX + x);
+            j = 255 - a;
+            Dest->PixelData[i].r = (UINT8) (((UINTN) Dest->PixelData[i].r * j + (UINTN) Colour.r * a) / 255);
+            Dest->PixelData[i].g = (UINT8) (((UINTN) Dest->PixelData[i].g * j + (UINTN) Colour.g * a) / 255);
+            Dest->PixelData[i].b = (UINT8) (((UINTN) Dest->PixelData[i].b * j + (UINTN) Colour.b * a) / 255);
+        }
+    }
+} // VOID WashArea()
+
+static UINTN CellW(VOID) {
+    UINTN w = egComputeTextWidth(L"M");
+    return (w > 0) ? w : 8;
+}
+
+// Compose the whole panel -- glass, title, lines, rows -- and put it up in one
+// piece. Drawing it in parts is what makes a menu flicker; this way the screen
+// changes once.
+static VOID PaintPanel(IN REFIT_MENU_SCREEN *Screen, IN SCROLL_STATE *State) {
+    EG_IMAGE *Panel, *Bar, *Mix;
+    UINTN     i, y, cw, tw, n, Alpha, f;
+    INTN      e;
+
+    Panel = MakePanel();
+    if (Panel == NULL)
+        return;
+    cw = CellW();
+
+    if (Screen->Title != NULL) {
+        tw = egComputeTextWidth(Screen->Title);
+        egRenderText(Screen->Title, Panel, (PanelW > tw) ? (PanelW - tw) / 2 : 0,
+                     PANEL_PAD_Y * RowH, 40);
+    }
+    y = RowTop;
+    for (i = 0; i < Screen->InfoLineCount; i++) {
+        if (Screen->InfoLines[i] != NULL)
+            egRenderText(Screen->InfoLines[i], Panel, PANEL_PAD_X * cw, y, 40);
+        y += RowH;
+    }
+    y += RowH / 2;
+
+    Bar = egCreateImage(PanelW - (PANEL_PAD_X - 1) * cw * 2, RowH, TRUE);
+    if (Bar != NULL)
+        RoundedAlpha(Bar, RowH / 3);
+    for (e = State->FirstVisible; (e <= State->LastVisible) && (e <= State->MaxIndex); e++) {
+        BOOLEAN Chosen = (e == State->CurrentSelection);
+        if (Chosen && (Bar != NULL))
+            WashArea(Panel, Bar, (PANEL_PAD_X - 1) * cw, y, RampAt(255), 225);
+        if (Screen->Entries[e]->Title != NULL)
+            egRenderText(Screen->Entries[e]->Title, Panel, PANEL_PAD_X * cw,
+                         y + (RowH - egGetFontHeight()) / 2, Chosen ? 230 : 40);
+        y += RowH;
+    }
+    egFreeImage(Bar);
+
+    // Cross-fade from whatever was there, so the highlight slides rather than
+    // snaps. Skipped the moment a key is already waiting.
+    if (GlobalConfig.Animations && (PanelShown != NULL) &&
+        (PanelShown->Width == PanelW) && (PanelShown->Height == PanelH) &&
+        (refit_call1_wrapper(BS->CheckEvent, ST->ConIn->WaitForKey) != EFI_SUCCESS)) {
+        Mix = egCreateImage(PanelW, PanelH, FALSE);
+        if (Mix != NULL) {
+            n = PanelW * PanelH;
+            for (f = 1; f <= PANEL_FADE; f++) {
+                Alpha = (256 * f) / PANEL_FADE;
+                for (i = 0; i < n; i++) {
+                    Mix->PixelData[i].r = (UINT8) (((UINTN) PanelShown->PixelData[i].r * (256 - Alpha) +
+                                                    (UINTN) Panel->PixelData[i].r * Alpha) >> 8);
+                    Mix->PixelData[i].g = (UINT8) (((UINTN) PanelShown->PixelData[i].g * (256 - Alpha) +
+                                                    (UINTN) Panel->PixelData[i].g * Alpha) >> 8);
+                    Mix->PixelData[i].b = (UINT8) (((UINTN) PanelShown->PixelData[i].b * (256 - Alpha) +
+                                                    (UINTN) Panel->PixelData[i].b * Alpha) >> 8);
+                }
+                BltImage(Mix, PanelX, PanelY);
+                refit_call1_wrapper(BS->Stall, 9000);
+            }
+            egFreeImage(Mix);
+        }
+    }
+    BltImage(Panel, PanelX, PanelY);
+    egFreeImage(PanelShown);
+    PanelShown = Panel;
+} // VOID PaintPanel()
+
+// The style every sub-menu is drawn with: settings, about, hidden tags, the
+// boot-options sub-screens. One appearance, not two.
+VOID ThemeMenuStyle(IN REFIT_MENU_SCREEN *Screen, IN SCROLL_STATE *State,
+                    IN UINTN Function, IN CHAR16 *ParamText) {
+    UINTN i, cw, Widest = 0, w, MaxRows;
+
+    switch (Function) {
+        case MENU_FUNCTION_INIT:
+            cw   = CellW();
+            RowH = egGetFontHeight() + egGetFontHeight() / 2;
+            if (Screen->Title != NULL)
+                Widest = egComputeTextWidth(Screen->Title);
+            for (i = 0; i < Screen->InfoLineCount; i++) {
+                w = egComputeTextWidth(Screen->InfoLines[i]);
+                if (w > Widest) Widest = w;
+            }
+            for (i = 0; i < Screen->EntryCount; i++) {
+                w = egComputeTextWidth(Screen->Entries[i]->Title);
+                if (w > Widest) Widest = w;
+            }
+            PanelW = Widest + 2 * PANEL_PAD_X * cw;
+            if (PanelW > UGAWidth - 8 * cw)
+                PanelW = UGAWidth - 8 * cw;
+
+            MaxRows = (UGAHeight - 8 * RowH) / RowH;
+            InitScroll(State, Screen->EntryCount, MaxRows);
+            // InitScroll works out how many things fit from the width of a menu
+            // TILE, which is the right answer for the main menu and gives five
+            // for a list of text: the sixth row of a six-row menu simply was not
+            // drawn. A panel of lines is bounded by the height of a line.
+            RowsCount = (MaxRows < Screen->EntryCount) ? MaxRows : Screen->EntryCount;
+            if (RowsCount < 1)
+                RowsCount = 1;
+            State->MaxVisible  = (INTN) RowsCount;
+            State->LastVisible = State->FirstVisible + State->MaxVisible - 1;
+
+            RowTop = PANEL_PAD_Y * RowH + RowH + RowH / 2;
+            PanelH = RowTop + Screen->InfoLineCount * RowH + RowH / 2
+                     + RowsCount * RowH + PANEL_PAD_Y * RowH;
+            PanelX = (UGAWidth  - PanelW) / 2;
+            PanelY = (UGAHeight - PanelH) / 2;
+            SwitchToGraphicsAndClear();
+            egFreeImage(PanelShown);
+            PanelShown = NULL;
+            break;
+
+        case MENU_FUNCTION_CLEANUP:
+            egFreeImage(PanelShown);
+            PanelShown = NULL;
+            break;
+
+        case MENU_FUNCTION_PAINT_ALL:
+        case MENU_FUNCTION_PAINT_SELECTION:
+            PaintPanel(Screen, State);
+            break;
+
+        case MENU_FUNCTION_PAINT_TIMEOUT:
+            if (ParamText != NULL) {
+                UINTN tw = egComputeTextWidth(ParamText);
+                DrawTextWithTransparency(L"", 0, PanelY + PanelH + RowH / 2);
+                DrawTextWithTransparency(ParamText, (UGAWidth - tw) / 2,
+                                         PanelY + PanelH + RowH / 2);
+            }
+            break;
+    }
+} // VOID ThemeMenuStyle()
+
+//
+// The settings screen
+//
+
+// Every picture sitting in EFI\refind\backgrounds, whatever put it there.
+static CHAR16 * ListBackgrounds(OUT UINTN *Count) {
+    REFIT_DIR_ITER  Iter;
+    EFI_FILE_INFO  *Entry;
+    CHAR16         *List = NULL, *Ext;
+
+    *Count = 0;
+    DirIterOpen(SelfDir, BACKGROUND_DIR, &Iter);
+    while (DirIterNext(&Iter, 2, NULL, &Entry)) {
+        if (Entry->FileName[0] == L'.')
+            continue;
+        Ext = FindExtension(Entry->FileName);
+        if (MyStriCmp(Ext, L".png") || MyStriCmp(Ext, L".jpg") ||
+            MyStriCmp(Ext, L".jpeg") || MyStriCmp(Ext, L".bmp")) {
+            MergeStrings(&List, Entry->FileName, L',');
+            (*Count)++;
+        }
+        MyFreePool(Ext);
+    }
+    DirIterClose(&Iter);
+    return List;
+} // CHAR16 * ListBackgrounds()
+
+// Write the choices where the next boot will find them. refind.conf ends with
+// `include theme.conf`, so what is written here is read last and wins; and the
+// file rEFInd ships with is never touched, so a bad setting is one deletion away
+// from the way it came.
+static BOOLEAN SaveTheme(VOID) {
+    EFI_FILE_PROTOCOL *File = NULL;
+    EFI_STATUS         Status;
+    CHAR16            *Body;
+    UINTN              Size;
+
+    // Delete first rather than truncate: writing a shorter file over a longer
+    // one would leave the tail of the old settings behind, and the tail of a
+    // config file is the part that wins.
+    Status = refit_call5_wrapper(SelfDir->Open, SelfDir, &File, THEME_FILE,
+                                 EFI_FILE_MODE_READ | EFI_FILE_MODE_WRITE, 0);
+    if (!EFI_ERROR(Status))
+        refit_call1_wrapper(File->Delete, File);
+    File = NULL;
+    Status = refit_call5_wrapper(SelfDir->Open, SelfDir, &File, THEME_FILE,
+                                 EFI_FILE_MODE_READ | EFI_FILE_MODE_WRITE |
+                                 EFI_FILE_MODE_CREATE, 0);
+    if (EFI_ERROR(Status))
+        return FALSE;
+    Body = PoolPrint(L"\xFEFF# Written by the boot menu's own settings screen.\r\n"
+                     L"# Delete this file to go back to what was installed.\r\n"
+                     L"background %s\r\n"
+                     L"darken %d\r\n"
+                     L"tint %d\r\n"
+                     L"frost_radius %d\r\n"
+                     L"animations %s\r\n",
+                     GlobalConfig.BackgroundFile ? GlobalConfig.BackgroundFile : L"",
+                     GlobalConfig.Darken, GlobalConfig.Tint, GlobalConfig.FrostRadius,
+                     GlobalConfig.Animations ? L"true" : L"false");
+    if (Body == NULL) {
+        refit_call1_wrapper(File->Close, File);
+        return FALSE;
+    }
+    Size = StrLen(Body) * sizeof(CHAR16);
+    Status = refit_call3_wrapper(File->Write, File, &Size, Body);
+    refit_call1_wrapper(File->Close, File);
+    MyFreePool(Body);
+    return !EFI_ERROR(Status);
+} // BOOLEAN SaveTheme()
+
+static VOID NextBackground(IN CHAR16 *List, IN UINTN Count, IN INTN By) {
+    CHAR16 *One;
+    UINTN   i = 0;
+    INTN    Current = -1, Wanted;
+
+    if ((List == NULL) || (Count == 0))
+        return;
+    while ((One = FindCommaDelimited(List, i)) != NULL) {
+        if ((GlobalConfig.BackgroundFile != NULL) &&
+            MyStriCmp(One, GlobalConfig.BackgroundFile))
+            Current = (INTN) i;
+        MyFreePool(One);
+        i++;
+    }
+    Wanted = ((Current + By) % (INTN) Count + (INTN) Count) % (INTN) Count;
+    One = FindCommaDelimited(List, (UINTN) Wanted);
+    if (One != NULL) {
+        MyFreePool(GlobalConfig.BackgroundFile);
+        GlobalConfig.BackgroundFile = One;
+    }
+} // VOID NextBackground()
+
+static CHAR16 * DarkenLabel(VOID) {
+    if (GlobalConfig.Darken == DARKEN_AUTO)
+        return PoolPrint(L"Dimming              automatic");
+    return PoolPrint(L"Dimming              %d%%", GlobalConfig.Darken);
+} // CHAR16 * DarkenLabel()
+
+VOID ShowSettingsMenu(VOID) {
+    REFIT_MENU_SCREEN  Menu = { L"Settings", NULL, 0, NULL, 0, NULL, 0, NULL,
+                                L"Enter changes a setting, Esc returns to the menu",
+                                L"" };
+    REFIT_MENU_ENTRY  *Rows[6], *Chosen;
+    MENU_STYLE_FUNC    Style = AllowGraphicsMode ? ThemeMenuStyle : TextMenuStyle;
+    CHAR16            *List;
+    UINTN              Count, Exit, i;
+    INTN               Default = 0;
+    BOOLEAN            Running = TRUE, Saved = FALSE;
+
+    List = ListBackgrounds(&Count);
+    if ((GlobalConfig.BackgroundFile == NULL) && (Count > 0))
+        NextBackground(List, Count, 1);
+
+    Menu.TitleImage = BuiltinIcon(BUILTIN_ICON_FUNC_ABOUT);
+    while (Running) {
+        // rebuilt every time round, because every title carries a value
+        for (i = 0; i < Menu.EntryCount; i++) {
+            MyFreePool(Menu.Entries[i]->Title);
+            MyFreePool(Menu.Entries[i]);
+        }
+        MyFreePool(Menu.Entries);
+        Menu.Entries = NULL;
+        Menu.EntryCount = 0;
+        for (i = 0; i < Menu.InfoLineCount; i++)
+            MyFreePool(Menu.InfoLines[i]);
+        MyFreePool(Menu.InfoLines);
+        Menu.InfoLines = NULL;
+        Menu.InfoLineCount = 0;
+
+        AddMenuInfoLine(&Menu, PoolPrint(L"%d photographs in EFI\\refind\\%s",
+                                         Count, BACKGROUND_DIR));
+        AddMenuInfoLine(&Menu, StrDuplicate(L"Drop your own in there from any system"));
+
+        Rows[0] = AllocateZeroPool(sizeof(REFIT_MENU_ENTRY));
+        Rows[0]->Title = PoolPrint(L"Background           %s",
+                                   GlobalConfig.BackgroundFile ?
+                                   GlobalConfig.BackgroundFile : L"(none found)");
+        Rows[1] = AllocateZeroPool(sizeof(REFIT_MENU_ENTRY));
+        Rows[1]->Title = DarkenLabel();
+        Rows[2] = AllocateZeroPool(sizeof(REFIT_MENU_ENTRY));
+        Rows[2]->Title = PoolPrint(L"Frosted glass        %d", GlobalConfig.FrostRadius);
+        Rows[3] = AllocateZeroPool(sizeof(REFIT_MENU_ENTRY));
+        Rows[3]->Title = PoolPrint(L"Colour from photo    %d%%", GlobalConfig.Tint);
+        Rows[4] = AllocateZeroPool(sizeof(REFIT_MENU_ENTRY));
+        Rows[4]->Title = PoolPrint(L"Animations           %s",
+                                   GlobalConfig.Animations ? L"on" : L"off");
+        Rows[5] = AllocateZeroPool(sizeof(REFIT_MENU_ENTRY));
+        Rows[5]->Title = StrDuplicate(Saved ? L"Saved. Press Esc to return"
+                                            : L"Save these for next time");
+        for (i = 0; i < 6; i++) {
+            Rows[i]->Tag = TAG_RETURN;
+            AddMenuEntry(&Menu, Rows[i]);
+        }
+
+        Exit = RunGenericMenu(&Menu, Style, &Default, &Chosen);
+        if (Exit != MENU_EXIT_ENTER) {
+            Running = FALSE;
+            continue;
+        }
+        Saved = FALSE;
+        if (Chosen == Rows[0]) {
+            NextBackground(List, Count, 1);
+        } else if (Chosen == Rows[1]) {
+            if (GlobalConfig.Darken == DARKEN_AUTO)      GlobalConfig.Darken = 0;
+            else if (GlobalConfig.Darken >= 80)          GlobalConfig.Darken = DARKEN_AUTO;
+            else                                          GlobalConfig.Darken += 10;
+        } else if (Chosen == Rows[2]) {
+            GlobalConfig.FrostRadius = (GlobalConfig.FrostRadius >= 32) ? 0
+                                       : GlobalConfig.FrostRadius + 4;
+        } else if (Chosen == Rows[3]) {
+            GlobalConfig.Tint = (GlobalConfig.Tint >= 100) ? 0 : GlobalConfig.Tint + 25;
+        } else if (Chosen == Rows[4]) {
+            GlobalConfig.Animations = !GlobalConfig.Animations;
+        } else if (Chosen == Rows[5]) {
+            Saved = SaveTheme();
+        }
+        if (Chosen != Rows[5])
+            ApplyTheme();
+        MarkScreenDirty();
+    } // while
+
+    MyFreePool(List);
+    for (i = 0; i < Menu.EntryCount; i++) {
+        MyFreePool(Menu.Entries[i]->Title);
+        MyFreePool(Menu.Entries[i]);
+    }
+    MyFreePool(Menu.Entries);
+    for (i = 0; i < Menu.InfoLineCount; i++)
+        MyFreePool(Menu.InfoLines[i]);
+    MyFreePool(Menu.InfoLines);
+    MarkScreenDirty();
+} // VOID ShowSettingsMenu()
