+    ToOld = ComposeMenuEntry(Old, FALSE, OX, OY);
+    ToNew = ComposeMenuEntry(New, TRUE,  NX, NY);
+    if (!GlobalConfig.Animations || KeyIsWaiting() || (ToOld == NULL) || (ToNew == NULL)) {
+        if (ToOld != NULL) BltImage(ToOld, OX, OY);
+        if (ToNew != NULL) BltImage(ToNew, NX, NY);
+    } else {
+        // What is on the screen is the same two tiles the other way round, and
+        // composing them costs nothing now that the glass is kept. Reading them
+        // back off the screen does not: a framebuffer is quick to write and slow
+        // to read, and this ran on every press of an arrow key.
