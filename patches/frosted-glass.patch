+// The menu arriving: each tile rises out of the photograph a beat after the one
+// to its left. Composed once each, then only mixed, so the cost per frame is
+// arithmetic rather than blur.
+static VOID AnimateMenuIn(IN REFIT_MENU_SCREEN *Screen, IN SCROLL_STATE *State,
+                          IN UINTN *itemPosX, IN UINTN row0PosY, IN UINTN row1PosY) {
+    EG_IMAGE *Tile[ANIM_MAX_TILES], *Back[ANIM_MAX_TILES];
+    UINTN     X[ANIM_MAX_TILES], Y[ANIM_MAX_TILES], Lift[ANIM_MAX_TILES];
+    UINTN     Count = 0, f, i, Alpha, Start, Steps, Drawn = 0, Rise, Room, Down;
+    UINT64    Began, Span;
+    INTN      e;
+
+    // How far a tile climbs, in this screen's pixels rather than the 4K ones the
+    // number was chosen at.
+    Rise = (ANIM_IN_RISE * UGAHeight) / 2160;
+    if (Rise < 2)
+        Rise = 2;
+
+    for (e = State->FirstVisible; (e <= State->MaxIndex) && (Count < ANIM_MAX_TILES); e++) {
+        if (Screen->Entries[e]->Row == 0) {
+            if (e > State->LastVisible)
+                continue;
+            X[Count] = itemPosX[e - State->FirstVisible];
+            Y[Count] = row0PosY;
+        } else {
+            X[Count] = itemPosX[e];
+            Y[Count] = row1PosY;
+        }
+        Tile[Count] = ComposeMenuEntry(Screen->Entries[e],
+                                       (e == State->CurrentSelection), X[Count], Y[Count]);
+        if (Tile[Count] == NULL)
+            continue;
+        // The band of photograph the tile travels over. It cannot reach past the
+        // bottom of the background, and on a short screen there may be no room
+        // at all -- in which case that tile simply fades where it stands.
+        Room = (GlobalConfig.ScreenBackground != NULL &&
+                GlobalConfig.ScreenBackground->Height > (Y[Count] + Tile[Count]->Height))
+             ? GlobalConfig.ScreenBackground->Height - (Y[Count] + Tile[Count]->Height) : 0;
+        Lift[Count] = (Room < Rise) ? Room : Rise;
+        Back[Count] = egCropImage(GlobalConfig.ScreenBackground, X[Count], Y[Count],
+                                  Tile[Count]->Width,
+                                  Tile[Count]->Height + Lift[Count]);
+        if (Back[Count] == NULL) {
+            egFreeImage(Tile[Count]);
+            continue;
+        }
+        Count++;
+    }
+
+    Steps = ANIM_IN_FRAMES + Count;
+    Span  = (UINT64) Steps * ANIM_IN_STEP_US;
+    Began = NowUs();
+    for (;;) {
+        UINT64 FrameAt = NowUs();
+        UINT64 Gone    = FrameAt - Began;
+        if (Gone >= Span)
+            break;
+        f = 1 + (UINTN) ((Gone * Steps) / Span);
+        for (i = 0; i < Count; i++) {
+            Start = i;
+            Alpha = (f > Start) ? EaseOut(f - Start, ANIM_IN_FRAMES) : 0;
+            // The same eased number moves the tile and fades it: it arrives
+            // where it stops being transparent, which is what makes the two
+            // read as one gesture rather than two.
+            Down  = Lift[i] - ((Lift[i] * Alpha) >> 8);
+            BlendBlitAt(Back[i], Tile[i], Alpha, X[i], Y[i], Down);
+        }
+        Drawn++;
+        if (!HoldFrame(FrameAt, ANIM_FRAME_US, TRUE))
+            break;
+    }
+    LOG(1, LOG_LINE_NORMAL,
+        L"Menu entrance: %d tiles, %d frames, %d ms of a wanted %d, clock %d ticks/us",
+        (INTN) Count, (INTN) Drawn, (INTN) ((NowUs() - Began) / 1000),
+        (INTN) (Span / 1000), (INTN) TicksPerUs);
+    // Whatever the timing did, end whole: the tile home, and the band it
+    // climbed over back to being photograph.
+    for (i = 0; i < Count; i++)
+        BlendBlitAt(Back[i], Tile[i], 256, X[i], Y[i], 0);
+    for (i = 0; i < Count; i++) {
+        egFreeImage(Tile[i]);
+        egFreeImage(Back[i]);
+    }
+} // VOID AnimateMenuIn()
