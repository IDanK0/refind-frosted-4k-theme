+// Give the display a moment to find the signal.
+//
+// A monitor takes a second or two to lock onto a mode, and shows nothing at all
+// until it has. The firmware is drawing the whole time, so on a slow display the
+// menu's arrival happens entirely inside that darkness and the first thing
+// anybody sees is a finished menu -- which looks exactly like an animation that
+// was never written. The photograph is already up by the time this is called, so
+// what the wait costs is a beat of wallpaper before the menu lands on it, and a
+// key ends it immediately.
+static VOID WaitForTheDisplay(VOID) {
+    UINT64 Until;
+
+    if ((GlobalConfig.EntranceDelay == 0) || !AllowGraphicsMode)
+        return;
+    Until = NowUs() + (UINT64) GlobalConfig.EntranceDelay * 1000;
+    while (NowUs() < Until) {
+        if (KeyIsWaiting())
+            return;
+        refit_call1_wrapper(BS->Stall, 10000);
+    }
+} // VOID WaitForTheDisplay()
