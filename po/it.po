#: background-gui.py:34
msgid "yours"
msgstr "tua"

#: background-gui.py:67 background-gui.py:80
msgid "Boot Menu Background"
msgstr "Sfondo del menu di avvio"

#: background-gui.py:81
msgid "pick one, or add a photo of your own"
msgstr "scegline uno, o aggiungi una tua foto"

#: background-gui.py:83
msgid "Add a photo of your own"
msgstr "Aggiungi una tua foto"

#: background-gui.py:103
msgid "Automatic dimming"
msgstr "Scurimento automatico"

#: background-gui.py:104
msgid "Dim the photo just enough for the glass and the labels to read"
msgstr "Attenua la foto quel tanto che basta perché il vetro e le scritte si leggano"
"Attenua la foto quel tanto che basta perché il vetro e le scritte si leggano"

#: background-gui.py:111
msgid "Dim by"
msgstr "Scurimento manuale"

#: background-gui.py:122
msgid "Match colours to the photo"
msgstr "Accorda i colori alla foto"

#: background-gui.py:123
msgid ""
"Draw the logos, labels and glass in the picture's own colour, instead of "
"Windows blue and Ubuntu orange"
msgstr "Disegna loghi, scritte e vetro nel colore della fotografia, invece dell'azzurro di Windows e dell'arancione di Ubuntu"

#: background-gui.py:132
msgid "Preview"
msgstr "Anteprima"

#: background-gui.py:134
msgid "Apply"
msgstr "Applica"

#: background-gui.py:163
#, python-brace-format
msgid "auto {0}%"
msgstr "auto {0}%"

#: background-gui.py:164
msgid "no dimming needed"
msgstr "non serve scurirla"

#: background-gui.py:185
msgid "Choose a photo"
msgstr "Scegli una foto"

#: background-gui.py:186
msgid "Images"
msgstr "Immagini"

#: background-gui.py:203
#, python-brace-format
msgid "Added: {0}"
msgstr "Aggiunta: {0}"

#: background-gui.py:215
msgid "Rendering…  (about ten seconds)"
msgstr "Genero l'anteprima…  (una decina di secondi)"

#: background-gui.py:229
#, python-brace-format
msgid "Failed: {0}"
msgstr "Errore: {0}"

#: background-gui.py:232
msgid "Preview opened — nothing was installed"
msgstr "Anteprima aperta — non ho installato niente"

#: background-gui.py:233
msgid "Installing…  (you will be asked for your password)"
msgstr "Installo…  (ti verrà chiesta la password)"

#: background-gui.py:247
#, python-brace-format
msgid "Install failed: {0}"
msgstr "Installazione non riuscita: {0}"

#: background-gui.py:247
msgid "cancelled"
msgstr "annullata"

#: background-gui.py:252
msgid "Done — reboot to see the new background"
msgstr "Fatto — riavvia per vedere il nuovo sfondo"
